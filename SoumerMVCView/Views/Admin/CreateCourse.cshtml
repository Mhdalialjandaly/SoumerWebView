@model SoumerMVCView.Models.CourseFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "إضافة مادة جديد" : "تعديل المادة";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4">
        <i class="fas fa-book me-2"></i> @ViewData["Title"]
    </h4>

    <form asp-action="@(Model.Id == 0 ? "CreateCourse" : "EditCourse")"
          asp-route-id="@(Model.Id == 0 ? null : Model.Id)"
          method="post"
          id="courseForm">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <!-- بيانات أساسية -->
        <div class="form-group">
            <label asp-for="Name">اسم المادة <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">الوصف</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price">السعر الأصلي (نقطة) <span class="text-danger">*</span></label>
            <input asp-for="Price"
                   class="form-control"
                   type="number"
                   min="0"
                   step="any"
                   inputmode="decimal"
                   required />
            <span asp-validation-for="Price" class="text-danger small"></span>
            <small class="text-muted">القيمة بالكامل. اتركها كما هي إن لم ترغب بتعديل السعر.</small>
        </div>

        <!-- تاريخ الإنشاء (للقراءة فقط عند التعديل) -->
        @if (Model.Id != 0)
        {
            <div class="form-group">
                <label>تاريخ الإنشاء</label>
                <input type="text"
                       class="form-control"
                       value="@Model.CreatedAtDisplay"
                       readonly
                       disabled
                       style="background:#f1f3f7; color:#6b7280;" />
                <small class="text-muted">هذا الحقل للعرض فقط ولا يمكن تعديله.</small>
            </div>
        }

        <!-- ============ قسم العرض الترويجي ============ -->
        <div class="card mb-3" style="border:2px solid #fef3c7; background:#fffbeb;">
            <div class="card-body">
                <h6 class="mb-3" style="color:#b45309;">
                    🔥 عرض لفترة محدودة (اختياري)
                </h6>

                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label asp-for="DiscountPrice">سعر العرض (نقطة)</label>
                        <input asp-for="DiscountPrice"
                               class="form-control"
                               type="number"
                               min="0"
                               step="any"
                               inputmode="decimal"
                               placeholder="اتركه فارغاً لإلغاء العرض" />
                        <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                        <small class="text-muted">اتركه فارغاً إن لم يوجد عرض.</small>
                    </div>

                    <div class="col-md-6 mb-2">
                        <label asp-for="DiscountEndDate">تاريخ ووقت انتهاء العرض</label>
                        <input asp-for="DiscountEndDate"
                               class="form-control"
                               type="datetime-local"
                               value="@(Model.DiscountEndDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                        <span asp-validation-for="DiscountEndDate" class="text-danger small"></span>
                        <small class="text-muted">بعد هذا التاريخ يعود السعر الأصلي تلقائياً.</small>
                    </div>
                </div>

                <!-- أزرار سريعة -->
                <div class="d-flex gap-2 flex-wrap mt-2">
                    <button type="button" class="btn btn-sm btn-light border" onclick="quickDate(7)">أسبوع</button>
                    <button type="button" class="btn btn-sm btn-light border" onclick="quickDate(14)">أسبوعان</button>
                    <button type="button" class="btn btn-sm btn-light border" onclick="quickDate(30)">شهر</button>
                    <button type="button" class="btn btn-sm btn-light border" onclick="clearDiscount()">إلغاء العرض</button>
                </div>

                <!-- معاينة فورية -->
                <div id="discountPreview"
                     class="mt-3"
                     style="display:none; background:#fff; border:1px dashed #fcd34d; border-radius:10px; padding:12px; text-align:center;">
                    <div style="font-size:0.85rem; color:#b45309; font-weight:700;">
                        🔥 سيُعرض للطلاب بخصم <span id="previewPercent">0%</span>
                    </div>
                    <div class="mt-1">
                        <span style="text-decoration:line-through; color:#9496a5;" id="previewOriginal"></span>
                        <strong style="color:#059669; font-size:1.1rem; margin-right:6px;" id="previewNew"></strong>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> حفظ
        </button>
        <a href="/Admin/Courses" class="btn btn-secondary">إلغاء</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const priceInput = document.getElementById('Price');
        const discountInput = document.getElementById('DiscountPrice');
        const endDateInput = document.getElementById('DiscountEndDate');
        const preview = document.getElementById('discountPreview');

        function updatePreview() {
            const price = parseFloat(priceInput.value);
            const discount = parseFloat(discountInput.value);

            if (!price || price <= 0 || !discount || discount <= 0 || discount >= price) {
                preview.style.display = 'none';
                return;
            }

            const diff = price - discount;
            const percent = Math.round(diff / price * 100);

            document.getElementById('previewPercent').textContent = percent + '%';
            document.getElementById('previewOriginal').textContent =
                Number(price).toLocaleString() + ' نقطة';
            document.getElementById('previewNew').textContent =
                Number(discount).toLocaleString() + ' نقطة';
            preview.style.display = 'block';
        }

        priceInput.addEventListener('input', updatePreview);
        discountInput.addEventListener('input', updatePreview);

        function quickDate(days) {
            const d = new Date();
            d.setDate(d.getDate() + days);
            d.setHours(23, 59, 0, 0);
            const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000)
                .toISOString()
                .slice(0, 16);
            endDateInput.value = local;
        }

        function clearDiscount() {
            discountInput.value = '';
            endDateInput.value = '';
            preview.style.display = 'none';
        }

        // معاينة أولية عند الفتح (إن وُجد عرض سابق)
        updatePreview();
    </script>
}
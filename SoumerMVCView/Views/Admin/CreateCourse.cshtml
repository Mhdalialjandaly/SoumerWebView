@model Course
@{
    ViewData["Title"] = Model.Id == 0 ? "إضافة كورس جديد" : "تعديل الكورس";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4">
        <i class="fas fa-book me-2"></i> @ViewData["Title"]
    </h4>

    <form asp-action="@(Model.Id == 0 ? "CreateCourse" : "EditCourse")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                <i class="fas fa-tag me-1"></i> اسم الكورس
            </label>
            <input asp-for="Name" class="form-control" required
                   placeholder="أدخل اسم الكورس...">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                <i class="fas fa-align-left me-1"></i> الوصف
            </label>
            <textarea asp-for="Description" class="form-control" rows="5"
                      placeholder="أدخل وصفاً مفصلاً للكورس..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                <i class="fas fa-coins me-1"></i> السعر (بالنقاط)
            </label>
            <input asp-for="Price" type="number" class="form-control" required
                   min="0" step="1" placeholder="أدخل سعر الكورس بالنقاط...">
            <small class="text-muted">السعر بالنقاط التي سيحتاجها الطالب للتسجيل في الكورس</small>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary-admin">
                <i class="fas fa-save"></i> حفظ الكورس
            </button>
            <a href="/Admin/Courses" class="btn btn-secondary">
                <i class="fas fa-times"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
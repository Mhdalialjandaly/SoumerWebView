@model List<TeacherCourse>
@{
    ViewData["Title"] = "إدارة روابط الأساتذة بالكورسات";
    Layout = "_AdminLayout";
}

<div class="teacher-courses-page">
    <div class="table-card">
        <div class="table-card-header">
            <h5 class="table-card-title">🔗 روابط الأساتذة بالكورسات</h5>
            <a href="/Admin/CreateTeacherCourse" class="btn-primary-admin" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                <i class="fas fa-link"></i> ربط أستاذ بكورس
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table class="table datatable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الأستاذ</th>
                        <th>المادة</th>
                        <th>الكورس</th>
                        <th>سعر الكورس</th>
                        <th>تاريخ الربط</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tc in Model)
                    {
                        <tr>
                            <td>@tc.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(tc.Teacher?.Image) ? "/images/default-avatar.png" : tc.Teacher.Image)"
                                         alt="@tc.Teacher?.Name"
                                         style="width: 35px; height: 35px; border-radius: 50%; object-fit: cover; margin-left: 10px;">
                                    <strong>@tc.Teacher?.Name</strong>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-status" style="background: #dbeafe; color: #3b82f6;">
                                    @tc.Teacher?.Subject
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info">@tc.Course?.Name</span>
                            </td>
                            <td>
                                <span class="badge badge-status" style="background: #d1fae5; color: #059669;">
                                    @tc.Course?.Price.ToString("N0") نقطة
                                </span>
                            </td>
                            <td>@tc.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <button class="btn-action btn-view" onclick="viewTeacherCourseDetails(@tc.Id)" title="عرض التفاصيل">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <form id="deleteForm-@tc.Id" action="/Admin/DeleteTeacherCourse" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@tc.Id" />
                                    <button type="button" class="btn-action btn-delete" onclick="confirmDelete(@tc.Id, 'teacherCourse')" title="حذف الربط">
                                        <i class="fas fa-unlink"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewTeacherCourseDetails(id) {
            Swal.fire({
                title: 'تفاصيل الربط',
                html: `
                    <div class="text-center">
                        <p>رقم الربط: <strong>${id}</strong></p>
                        <p class="text-muted">يمكنك عرض التفاصيل الكاملة من خلال صفحات الأساتذة والكورسات</p>
                    </div>
                `,
                icon: 'info',
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#4f46e5'
            });
        }

        function confirmDelete(id, type) {
            let message = '';
            switch(type) {
                case 'teacherCourse':
                    message = 'هل أنت متأكد من حذف هذا الربط؟ لن يتمكن الأستاذ من الوصول إلى هذا الكورس بعد الحذف.';
                    break;
                default:
                    message = 'هل أنت متأكد من حذف هذا العنصر؟';
            }

            Swal.fire({
                title: 'تأكيد الحذف',
                text: message,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'نعم، احذف',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${id}`).submit();
                }
            });
        }
    </script>
}
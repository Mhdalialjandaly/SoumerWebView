@model TeacherCourse
@{
    ViewData["Title"] = "ربط أستاذ بكورس";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4">
        <i class="fas fa-link me-2"></i> @ViewData["Title"]
    </h4>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="CreateTeacherCourse" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TeacherId" class="form-label">
                    <i class="fas fa-chalkboard-teacher me-1"></i> الأستاذ
                </label>
                <select asp-for="TeacherId" class="form-select select2" required>
                    <option value="">اختر الأستاذ...</option>
                    @foreach (var teacher in ViewBag.Teachers)
                    {
                        <option value="@teacher.Id">@teacher.Name - @teacher.Subject</option>
                    }
                </select>
                <span asp-validation-for="TeacherId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CourseId" class="form-label">
                    <i class="fas fa-book me-1"></i> الكورس
                </label>
                <select asp-for="CourseId" class="form-select select2" required>
                    <option value="">اختر الكورس...</option>
                    @foreach (var course in ViewBag.Courses)
                    {
                        <option value="@course.Id">@course.Name - @course.Price.ToString("N0") نقطة</option>
                    }
                </select>
                <span asp-validation-for="CourseId" class="text-danger"></span>
            </div>
        </div>

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            <strong>ملاحظة:</strong> سيتم ربط الأستاذ المحدد بالكورس المحدد. تأكد من عدم وجود ربط مسبق بينهما.
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-primary-admin" style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
                <i class="fas fa-link"></i> ربط الأستاذ بالكورس
            </button>
            <a href="/Admin/TeacherCourses" class="btn btn-secondary">
                <i class="fas fa-times"></i> إلغاء
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            $('.select2').select2({
                theme: 'bootstrap-5',
                language: 'ar',
                dir: 'rtl',
                placeholder: 'اختر...'
            });
        });
    </script>
}
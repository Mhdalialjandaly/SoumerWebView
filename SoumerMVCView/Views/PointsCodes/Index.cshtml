@model PointsCodesViewModel
@{
    ViewData["Title"] = "إدارة أكواد النقاط";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="stat-value">@Model.TotalValid</div>
            <div class="stat-label">أكواد صالحة</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-success bg-opacity-10 text-success">
                <i class="fas fa-coins"></i>
            </div>
            <div class="stat-value">@Model.TotalValidPoints.ToString("N0")</div>
            <div class="stat-label">نقاط صالحة</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-value">@Model.TotalUsed</div>
            <div class="stat-label">أكواد مستخدمة</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                <i class="fas fa-hand-holding-usd"></i>
            </div>
            <div class="stat-value">@Model.TotalUsedPoints.ToString("N0")</div>
            <div class="stat-label">نقاط مستخدمة</div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <h5 class="table-card-title"><i class="fas fa-ticket-alt me-2"></i>الأكواد الصالحة</h5>
        <div>
            <a asp-action="Create" class="btn-primary-admin">
                <i class="fas fa-plus"></i> إنشاء أكواد
            </a>
            <a asp-action="ExportCodes" class="btn btn-outline-primary ms-2">
                <i class="fas fa-download"></i> تصدير
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table datatable">
            <thead>
                <tr>
                    <th>الكود</th>
                    <th>القيمة</th>
                    <th>تاريخ الإنشاء</th>
                    <th>تاريخ الانتهاء</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var code in Model.ValidCodes)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary bg-opacity-10 text-primary" style="font-family: monospace; font-size: 1rem;">
                                @code.Code
                            </span>
                        </td>
                        <td>
                            <strong class="text-success">@code.PointsValue.ToString("N0")</strong>
                            <small class="text-muted">نقطة</small>
                        </td>
                        <td>@code.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td>
                            @if (code.ExpiryDate.HasValue)
                            {
                                <span class="@(code.ExpiryDate < DateTime.Now ? "text-danger" : "")">
                                    @code.ExpiryDate.Value.ToString("yyyy/MM/dd")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">لا يوجد</span>
                            }
                        </td>
                        <td>
                            @if (code.IsExpired)
                            {
                                <span class="badge bg-danger">منتهي</span>
                            }
                            else
                            {
                                <span class="badge bg-success">صالحة</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button class="btn-action btn-view" onclick="copyCode('@code.Code')" title="نسخ الكود">
                                    <i class="fas fa-copy"></i>
                                </button>
                                <a asp-action="Details" asp-route-id="@code.Id" class="btn-action btn-edit" title="تفاصيل">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form asp-action="Delete" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@code.Id" />
                                    <button type="button" class="btn-action btn-delete" onclick="confirmDelete(this)" title="حذف">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="table-card mt-4">
    <div class="table-card-header">
        <h5 class="table-card-title"><i class="fas fa-history me-2"></i>الأكواد المستخدمة</h5>
    </div>

    <div class="table-responsive">
        <table class="table datatable">
            <thead>
                <tr>
                    <th>الكود</th>
                    <th>القيمة</th>
                    <th>المستخدم</th>
                    <th>تاريخ الاستخدام</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var code in Model.UsedCodes)
                {
                    <tr>
                        <td>
                            <span class="badge bg-secondary" style="font-family: monospace;">
                                @code.Code
                            </span>
                        </td>
                        <td>
                            <strong>@code.PointsValue.ToString("N0")</strong>
                            <small class="text-muted">نقطة</small>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(code.UsedByUserName))
                            {
                                <strong>@code.UsedByUserName</strong>
                            }
                            else
                            {
                                <span class="text-muted">غير معروف</span>
                            }
                        </td>
                        <td>@code.UsedAt?.ToString("yyyy/MM/dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function copyCode(code) {
            navigator.clipboard.writeText(code).then(() => {
                Swal.fire({
                    title: 'تم النسخ!',
                    text: 'تم نسخ الكود إلى الحافظة',
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                });
            });
        }

        function confirmDelete(btn) {
            Swal.fire({
                title: 'تأكيد الحذف',
                text: 'هل أنت متأكد من حذف هذا الكود؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'حذف',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    btn.closest('form').submit();
                }
            });
        }
    </script>
}
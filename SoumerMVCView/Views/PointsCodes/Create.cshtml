@model CreatePointsCodeDto
@{
    ViewData["Title"] = "إنشاء أكواد نقاط";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4"><i class="fas fa-ticket-alt me-2"></i>إنشاء أكواد نقاط جديدة</h4>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="PointsValue" class="form-label fw-bold">قيمة النقاط</label>
                <input asp-for="PointsValue" class="form-control" type="number" min="1" required />
                <span asp-validation-for="PointsValue" class="text-danger"></span>
                <small class="text-muted">عدد النقاط التي سيحصل عليها المستخدم عند استخدام الكود</small>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="NumberOfCodes" class="form-label fw-bold">عدد الأكواد</label>
                <input asp-for="NumberOfCodes" class="form-control" type="number" min="1" max="100" value="1" required />
                <span asp-validation-for="NumberOfCodes" class="text-danger"></span>
                <small class="text-muted">الحد الأقصى 100 كود في المرة الواحدة</small>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ExpiryDate" class="form-label fw-bold">تاريخ الانتهاء (اختياري)</label>
            <input asp-for="ExpiryDate" class="form-control" type="date" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            <small class="text-muted">اتركه فارغاً إذا كان الكود لا ينتهي</small>
        </div>

        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>
            سيتم توليد أكواد فريدة بصيغة XXXX-XXXX-XXXX
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary-admin">
                <i class="fas fa-magic"></i> توليد الأكواد
            </button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
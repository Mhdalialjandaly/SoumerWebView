@model BalanceViewModel
@{
    ViewData["Title"] = "جميع المعاملات";
}

<div class="container-fluid mt-4" dir="rtl">
    <!-- Header with Balance Summary -->
    <div class="transactions-header">
        <div class="header-left">
            <h1 class="transactions-title">📊 سجل المعاملات</h1>
            <p class="transactions-subtitle">تتبع جميع عمليات النقاط الخاصة بك</p>
        </div>
        <div class="header-right">
            <div class="current-balance-card">
                <div class="balance-label">الرصيد الحالي</div>
                <div class="balance-amount-large-v2">@Model.CurrentBalance.ToString("N0") <span>نقطة</span></div>
            </div>
        </div>
    </div>

    <!-- Stats Summary -->
    <div class="transactions-stats">
        <div class="stat-item">
            <div class="stat-icon">📈</div>
            <div class="stat-info">
                <div class="stat-value">@Model.RecentTransactions?.Count(t => t.TransactionType == TransactionType.Credit) ?? 0</div>
                <div class="stat-label">عمليات إيداع</div>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon">📉</div>
            <div class="stat-info">
                <div class="stat-value">@Model.RecentTransactions?.Count(t => t.TransactionType == TransactionType.Debit) ?? 0</div>
                <div class="stat-label">عمليات خصم</div>
            </div>
        </div>
        <div class="stat-item">
            <div class="stat-icon">💰</div>
            <div class="stat-info">
                <div class="stat-value">@(Model.RecentTransactions?.Sum(t => t.TransactionType == TransactionType.Credit ? t.Amount : -t.Amount) ?? 0)</div>
                <div class="stat-label">صافي الحركة</div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="transactions-table-wrapper">
        <div class="table-header">
            <div class="table-title">
                <span class="title-icon">📋</span>
                <span>قائمة المعاملات</span>
            </div>
            <div class="table-info">
                إجمالي @(Model.RecentTransactions?.Count() ?? 0) معاملة
            </div>
        </div>

        <div class="transactions-table-responsive">
            <table class="transactions-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>النوع</th>
                        <th>المبلغ</th>
                        <th>الوصف</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                    {
                        foreach (var transaction in Model.RecentTransactions)
                        {
                            <tr class="transaction-row">
                                <td class="transaction-date">
                                    <div class="date-day">@transaction.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <div class="date-time">@transaction.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    @if (transaction.TransactionType == TransactionType.Credit)
                                    {
                                        <span class="badge-credit">
                                            <span class="badge-icon">➕</span>
                                            إضافة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-debit">
                                            <span class="badge-icon">➖</span>
                                            خصم
                                        </span>
                                    }
                                </td>
                                <td class="transaction-amount @(transaction.TransactionType == TransactionType.Credit ? "amount-positive" : "amount-negative")">
                                    @(transaction.TransactionType == TransactionType.Credit ? "+" : "-") @transaction.Amount.ToString("N0")
                                </td>
                                <td class="transaction-description">
                                    @if (!string.IsNullOrEmpty(transaction.Description))
                                    {
                                        <div class="desc-text">@transaction.Description</div>
                                    }
                                    else
                                    {
                                        <span class="desc-empty">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="empty-table">
                                <div class="empty-transactions-state">
                                    <div class="empty-icon">📭</div>
                                    <p>لا توجد معاملات حتى الآن</p>
                                    <small>قم بالتسجيل في كورسات أو قم بشراء نقاط لتبدأ</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="pagination-wrapper">
                <div class="pagination-info">
                    عرض صفحة @Model.CurrentPage من @Model.TotalPages
                </div>
                <div class="pagination-controls">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="/Balance/Transactions?page=@(Model.CurrentPage - 1)" class="page-btn prev">
                            <span>→</span> السابقة
                        </a>
                    }

                    <div class="page-numbers">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.CurrentPage)
                            {
                                <span class="page-number active">@i</span>
                            }
                            else if (Math.Abs(i - Model.CurrentPage) <= 2 || i == 1 || i == Model.TotalPages)
                            {
                                <a href="/Balance/Transactions?page=@i" class="page-number">@i</a>
                            }
                            else if (Math.Abs(i - Model.CurrentPage) == 3)
                            {
                                <span class="page-dots">...</span>
                            }
                        }
                    </div>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="/Balance/Transactions?page=@(Model.CurrentPage + 1)" class="page-btn next">
                            التالية <span>←</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="back-action">
        <a href="/Balance/Index" class="back-link">
            <span>←</span> العودة لصفحة الرصيد
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Add animation to transaction rows on load
        document.addEventListener('DOMContentLoaded', function() {
            const rows = document.querySelectorAll('.transaction-row');
            rows.forEach((row, index) => {
                row.style.animationDelay = `${index * 0.05}s`;
                row.classList.add('animate-in');
            });
        });
    </script>
}
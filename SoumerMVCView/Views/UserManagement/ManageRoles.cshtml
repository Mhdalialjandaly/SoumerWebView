@model UserRolesViewModel
@{
    ViewData["Title"] = "إدارة أدوار المستخدم";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4"><i class="fas fa-user-tag me-2"></i>@Model.UserName</h4>
    <form asp-action="ManageRoles" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <div class="mb-3">
            <label class="form-label fw-bold">الأدوار المتاحة</label>
            <div class="row">
                @foreach (var role in Model.AllRoles)
                {
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role" @(Model.UserRoles.Contains(role) ? "checked" : "") />
                            <label class="form-check-label">@role</label>
                        </div>
                    </div>
                }
            </div>
        </div>
        <button type="submit" class="btn btn-primary">حفظ الأدوار</button>
        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
    </form>
</div>
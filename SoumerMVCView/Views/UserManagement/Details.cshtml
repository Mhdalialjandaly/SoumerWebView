@model UserDto
@{
    ViewData["Title"] = "تفاصيل المستخدم";
    Layout = "_AdminLayout";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
}

<div class="form-card">
    <h4 class="mb-4"><i class="fas fa-user me-2"></i>تفاصيل المستخدم</h4>

    <div class="row">
        <div class="col-md-4 text-center mb-4">
            <div class="user-detail-avatar">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.UserName" />
                }
                else
                {
                    <div class="avatar-placeholder">
                        @(string.IsNullOrEmpty(Model.FullName) ? Model.UserName?.Substring(0, 1).ToUpper() : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                }
            </div>
            <h5 class="mt-3">@(string.IsNullOrEmpty(Model.FullName) ? Model.UserName : Model.FullName)</h5>
            @if (!string.IsNullOrEmpty(Model.FullName))
            {
                <small class="text-muted">@Model.UserName</small>
            }
        </div>

        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-4">اسم المستخدم</dt>
                <dd class="col-sm-8">@Model.UserName</dd>

                <dt class="col-sm-4">الاسم الكامل</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.FullName) ? "غير محدد" : Model.FullName)</dd>

                <dt class="col-sm-4">البريد الإلكتروني</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">الحالة</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">معطل</span>
                    }
                </dd>

                <dt class="col-sm-4">الوصف</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Description) ? "لا يوجد وصف" : Model.Description)</dd>

                <dt class="col-sm-4">تاريخ التسجيل</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy/MM/dd")</dd>

                <dt class="col-sm-4">آخر دخول</dt>
                <dd class="col-sm-8">@Model.LastLogin?.ToString("yyyy/MM/dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h5>الأدوار</h5>
            @if (roles.Any())
            {
                <ul class="list-unstyled">
                    @foreach (var role in roles)
                    {
                        <li class="mb-2"><span class="badge bg-primary">@role</span></li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted">لا توجد أدوار مخصصة</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
        <a asp-action="ManageRoles" asp-route-id="@Model.Id" class="btn btn-info">إدارة الأدوار</a>
        <a asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn btn-warning">تغيير كلمة المرور</a>
        <a asp-action="Index" class="btn btn-secondary">رجوع</a>
    </div>
</div>

<style>
    .user-detail-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        margin: 0 auto;
        border: 3px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
    }

        .user-detail-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .avatar-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
</style>
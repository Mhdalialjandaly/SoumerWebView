@model CreateUserDto
@{
    ViewData["Title"] = "إنشاء مستخدم جديد";
    Layout = "_AdminLayout";
}

<div class="form-card">
    <h4 class="mb-4"><i class="fas fa-user-plus me-2"></i>@ViewData["Title"]</h4>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="UserName" class="form-label fw-bold">اسم المستخدم</label>
                <input asp-for="UserName" class="form-control" required />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                <input asp-for="Email" class="form-control" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-bold">كلمة المرور</label>
            <input asp-for="Password" class="form-control" type="password" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">الوصف</label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
            <label asp-for="IsActive" class="form-check-label fw-bold">نشط</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary-admin"><i class="fas fa-save"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model ExamResultDto
@{
    ViewData["Title"] = "نتيجة الامتحان";
}

<div class="exam-result-page">

    <!-- بطاقة النتيجة الرئيسية -->
    <div class="result-hero @(Model.IsPassed ? "passed" : "failed")">
        <div class="result-icon">
            <i class="fas @(Model.IsPassed ? "fa-check-circle" : "fa-times-circle")"></i>
        </div>
        <h1 class="result-status">
            @if (Model.IsPassed)
            {
                @:🎉 مبروك، نجحت!
            }
            else
            {
                @:للأسف، لم تنجح
            }
        </h1>
        <p class="result-exam-title">@Model.ExamTitle</p>
        <p class="result-course-name">@Model.CourseName</p>

        @if (!string.IsNullOrEmpty(Model.EndReason) && Model.EndReason == "ForcedFail")
        {
            <div class="result-reason-warning">
                <i class="fas fa-exclamation-triangle"></i>
                تم اعتبارك راسباً بسبب مغادرة صفحة الامتحان
            </div>
        }
        else if (Model.EndReason == "TimeExpired")
        {
            <div class="result-reason-warning">
                <i class="fas fa-clock"></i>
                تم تسليم الامتحان تلقائياً لانتهاء الوقت
            </div>
        }

        <!-- نسبة النجاح -->
        <div class="result-score-circle">
            <div class="result-score-value">@Model.Percentage%</div>
            <div class="result-score-label">@Model.Score.ToString("N0") / @Model.MaxScore.ToString("N0") نقطة</div>
        </div>
    </div>

    <!-- إحصائيات -->
    <div class="result-stats">
        <div class="result-stat">
            <div class="result-stat-icon"><i class="fas fa-check"></i></div>
            <div>
                <div class="result-stat-value">@Model.CorrectAnswers / @Model.TotalQuestions</div>
                <div class="result-stat-label">إجابات صحيحة</div>
            </div>
        </div>
        <div class="result-stat">
            <div class="result-stat-icon"><i class="fas fa-percentage"></i></div>
            <div>
                <div class="result-stat-value">@Model.PassingScore%</div>
                <div class="result-stat-label">حد النجاح</div>
            </div>
        </div>
        <div class="result-stat">
            <div class="result-stat-icon"><i class="fas fa-clock"></i></div>
            <div>
                <div class="result-stat-value">@(Model.DurationSeconds / 60) د</div>
                <div class="result-stat-label">مدة الحل</div>
            </div>
        </div>
    </div>

    <!-- تفاصيل الأسئلة -->
    <div class="result-details">
        <h2 class="result-details-title">تفاصيل الإجابات</h2>
        @foreach (var q in Model.Questions)
        {
            <div class="result-question @(q.IsCorrect ? "correct" : "wrong")">
                <div class="result-question-header">
                    <span class="result-question-status">
                        <i class="fas @(q.IsCorrect ? "fa-check" : "fa-times")"></i>
                    </span>
                    <span class="result-question-points">@q.PointsEarned / @q.Points نقطة</span>
                </div>
                <p class="result-question-text">@q.QuestionText</p>

                <div class="result-answers">
                    @if (q.SelectedOptionId.HasValue)
                    {
                        <div class="result-answer @(q.IsCorrect ? "answer-correct" : "answer-wrong")">
                            <strong>إجابتك:</strong> @q.SelectedOptionText
                        </div>
                    }
                    else
                    {
                        <div class="result-answer answer-wrong">
                            <strong>إجابتك:</strong> لم تُجب على هذا السؤال
                        </div>
                    }

                    @if (!q.IsCorrect && !string.IsNullOrEmpty(q.CorrectOptionText))
                    {
                        <div class="result-answer answer-correct">
                            <strong>الإجابة الصحيحة:</strong> @q.CorrectOptionText
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- أزرار -->
    <div class="result-actions">
        <a href="/Exam/Index?courseId=@ViewBag.CourseId" class="result-btn result-btn-ghost">
            <i class="fas fa-arrow-right"></i>
            العودة للامتحانات
        </a>
        <a href="/MyCourses/Index" class="result-btn result-btn-primary">
            <i class="fas fa-book-open"></i>
            موادي
        </a>
    </div>
</div>

<style>
    .exam-result-page {
        max-width: 800px;
        margin: 0 auto;
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    .result-hero {
        text-align: center;
        padding: var(--spacing-xl);
        border-radius: var(--radius-xl);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .result-hero.passed {
            background: linear-gradient(135deg, #059669, #047857);
        }

        .result-hero.failed {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
        }

    .result-icon {
        font-size: 3.5rem;
        margin-bottom: 12px;
    }

    .result-status {
        font-size: 1.4rem;
        font-weight: 900;
        margin: 0 0 6px;
    }

    .result-exam-title {
        font-size: 0.95rem;
        opacity: 0.9;
        margin: 0 0 3px;
    }

    .result-course-name {
        font-size: 0.8rem;
        opacity: 0.7;
        margin: 0 0 16px;
    }

    .result-reason-warning {
        background: rgba(255, 255, 255, 0.2);
        padding: 10px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-size: 0.82rem;
        font-weight: 700;
        display: inline-block;
    }

    .result-score-circle {
        display: inline-flex;
        flex-direction: column;
        background: rgba(255, 255, 255, 0.2);
        border: 3px solid rgba(255, 255, 255, 0.4);
        padding: 20px 32px;
        border-radius: var(--radius-xl);
        backdrop-filter: blur(10px);
    }

    .result-score-value {
        font-size: 2.5rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 4px;
    }

    .result-score-label {
        font-size: 0.8rem;
        opacity: 0.9;
    }

    .result-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-md);
    }

    .result-stat {
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-md);
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: var(--shadow-sm);
    }

    .result-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--primary-soft);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .result-stat-value {
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--text-color);
    }

    .result-stat-label {
        font-size: 0.68rem;
        color: var(--icon-color);
    }

    .result-details {
        background: var(--white);
        border-radius: var(--radius-xl);
        padding: var(--spacing-lg);
        border: 1px solid var(--border-color);
    }

    .result-details-title {
        font-size: 0.95rem;
        font-weight: 800;
        margin: 0 0 var(--spacing-md);
        padding-bottom: 10px;
        border-bottom: 1px solid var(--border-color);
    }

    .result-question {
        padding: var(--spacing-md);
        border-radius: var(--radius-md);
        margin-bottom: 10px;
        border: 1px solid var(--border-color);
    }

        .result-question.correct {
            background: #f0fdf4;
            border-color: #a7f3d0;
        }

        .result-question.wrong {
            background: #fef2f2;
            border-color: #fecaca;
        }

    .result-question-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .result-question-status {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
    }

    .result-question.correct .result-question-status {
        background: #059669;
        color: #fff;
    }

    .result-question.wrong .result-question-status {
        background: #dc2626;
        color: #fff;
    }

    .result-question-points {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--icon-color);
    }

    .result-question-text {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text-color);
        margin: 0 0 10px;
        line-height: 1.5;
    }

    .result-answers {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .result-answer {
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .answer-correct {
        background: #d1fae5;
        color: #059669;
    }

    .answer-wrong {
        background: #fee2e2;
        color: #dc2626;
    }

    .result-actions {
        display: flex;
        gap: var(--spacing-md);
        justify-content: center;
    }

    .result-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .result-btn-primary {
        background: var(--primary-color);
        color: #fff;
    }

        .result-btn-primary:hover {
            background: var(--primary-dark);
            color: #fff;
        }

    .result-btn-ghost {
        background: var(--white);
        color: var(--text-color);
        border: 2px solid var(--border-color);
    }

        .result-btn-ghost:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

    @@media (max-width: 500px) {
        .result-stats {
            grid-template-columns: 1fr;
        }

        .result-actions {
            flex-direction: column;
        }

        .result-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
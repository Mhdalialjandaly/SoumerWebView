@using Microsoft.AspNetCore.Identity
@using DataAccess.Entities
@inject UserManager<User> UserManager
@{
    ViewData["Title"] = "الملف الشخصي";
    var user = await UserManager.GetUserAsync(User);
}

<div class="profile-container">
    <!-- HEADER -->
    <div class="profile-header">
        <div class="profile-cover">
            <div class="profile-avatar-wrapper">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                    {
                        <img src="@user.AvatarUrl" alt="@user.UserName" />
                    }
                    else
                    {
                        <span>👨‍🏫</span>
                    }
                </div>
                <button class="change-avatar-btn" id="changeAvatarBtn" title="تغيير الصورة">
                    📷
                </button>
            </div>
            <div class="profile-info">
                <h1 class="profile-name">@(user?.FullName ?? user?.UserName)</h1>
                <p class="profile-email">@user?.Email</p>
                <div class="profile-badges">
                    @if (user?.EmailConfirmed == true)
                    {
                        <span class="badge">
                            <span class="badge-icon">✅</span>
                            البريد مؤكد
                        </span>
                    }
                    @if (user?.IsActive == true)
                    {
                        <span class="badge">
                            <span class="badge-icon">🟢</span>
                            نشط
                        </span>
                    }
                </div>
            </div>
            <button class="edit-profile-btn" id="editProfileBtn">
                ✏️ تعديل الملف الشخصي
            </button>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="profile-content">
        <!-- SIDEBAR -->
        <div class="profile-sidebar">
            <!-- STATS -->
            <div class="stats-card">
                <h3>📊 إحصائيات</h3>
                <div class="stat-item">
                    <div class="stat-icon">📅</div>
                    <div class="stat-info">
                        <span class="stat-label">تاريخ الانضمام</span>
                        <span class="stat-value">@user?.CreatedAt.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">🕒</div>
                    <div class="stat-info">
                        <span class="stat-label">آخر دخول</span>
                        <span class="stat-value">@(user?.LastLogin?.ToString("dd MMMM yyyy") ?? "لم يسجل بعد")</span>
                    </div>
                </div>
            </div>

            <!-- QUICK ACTIONS -->
            <div class="quick-actions-card">
                <h3>⚡ إجراءات سريعة</h3>
                <button class="quick-action" onclick="location.href='/Account/ChangePassword'">
                    <span>🔑</span>
                    تغيير كلمة المرور
                </button>
                <button class="quick-action" onclick="location.href='/Account/Settings'">
                    <span>⚙️</span>
                    الإعدادات
                </button>
                <button class="quick-action" onclick="location.href='/MyCourses/Index'">
                    <span>📖</span>
                    كورساتي
                </button>
                <button class="quick-action" onclick="location.href='/Balance/Index'">
                    <span>💎</span>
                    نقاطي
                </button>
            </div>
        </div>

        <!-- MAIN -->
        <div class="profile-main">
            <!-- PERSONAL INFO -->
            <div class="info-card">
                <div class="card-header">
                    <h3>📋 المعلومات الشخصية</h3>
                    <button class="edit-section-btn" data-section="personal">
                        تعديل
                    </button>
                </div>
                <div class="info-grid">
                    <div class="info-field">
                        <label>اسم المستخدم</label>
                        <div class="field-value" id="usernameValue">@user?.UserName</div>
                        <input type="text" class="edit-input" id="usernameInput" value="@user?.UserName" style="display: none;">
                    </div>
                    <div class="info-field">
                        <label>الاسم الكامل</label>
                        <div class="field-value" id="fullNameValue">@(user?.FullName ?? "غير محدد")</div>
                        <input type="text" class="edit-input" id="fullNameInput" value="@user?.FullName" style="display: none;">
                    </div>
                    <div class="info-field">
                        <label>البريد الإلكتروني</label>
                        <div class="field-value" id="emailValue">@user?.Email</div>
                        <input type="email" class="edit-input" id="emailInput" value="@user?.Email" style="display: none;">
                    </div>
                    <div class="info-field">
                        <label>رقم الهاتف</label>
                        <div class="field-value" id="phoneValue">@(user?.PhoneNumber ?? "غير مضاف")</div>
                        <input type="tel" class="edit-input" id="phoneInput" value="@user?.PhoneNumber" style="display: none;">
                    </div>
                    <div class="info-field full-width">
                        <label>الوصف</label>
                        <div class="field-value" id="descriptionValue">@(user?.Description ?? "لا يوجد وصف")</div>
                        <textarea class="edit-input" id="descriptionInput" rows="3" style="display: none;">@user?.Description</textarea>
                    </div>
                </div>
                <div class="edit-actions" id="personalEditActions" style="display: none;">
                    <button class="save-btn" onclick="savePersonalInfo()">💾 حفظ</button>
                    <button class="cancel-btn" onclick="cancelEdit('personal')">إلغاء</button>
                </div>
            </div>

            <!-- SECURITY -->
            <div class="info-card">
                <div class="card-header">
                    <h3>🔐 الأمان</h3>
                </div>
                <div class="security-options">
                    <div class="security-item">
                        <div class="security-info">
                            <span class="security-icon">🔑</span>
                            <div>
                                <h4>كلمة المرور</h4>
                                <p>تغيير كلمة المرور الخاصة بك</p>
                            </div>
                        </div>
                        <button class="security-action" onclick="location.href='/Account/ChangePassword'">
                            تغيير
                        </button>
                    </div>
                    <div class="security-item">
                        <div class="security-info">
                            <span class="security-icon">📧</span>
                            <div>
                                <h4>البريد الإلكتروني</h4>
                                <p>@(user?.EmailConfirmed == true ? "تم التحقق" : "لم يتم التحقق")</p>
                            </div>
                        </div>
                        @if (user?.EmailConfirmed != true)
                        {
                            <button class="security-action" onclick="verifyEmail()">
                                تحقق
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AVATAR MODAL -->
<div id="avatarModal" class="modal">
    <div class="modal-content avatar-modal">
        <h3>تغيير الصورة الشخصية</h3>
        <div class="avatar-options">
            <div class="avatar-option" data-avatar="👨‍🏫">👨‍🏫</div>
            <div class="avatar-option" data-avatar="👩‍🏫">👩‍🏫</div>
            <div class="avatar-option" data-avatar="👨‍🎓">👨‍🎓</div>
            <div class="avatar-option" data-avatar="👩‍🎓">👩‍🎓</div>
            <div class="avatar-option" data-avatar="📚">📚</div>
            <div class="avatar-option" data-avatar="🎓">🎓</div>
        </div>
        <button class="close-modal-btn">إغلاق</button>
    </div>
</div>

<script>
    let currentEditSection = null;
    let originalValues = {};

    function editSection(section) {
        currentEditSection = section;

        if (section === 'personal') {
            originalValues = {
                username: document.getElementById('usernameValue').innerText,
                fullName: document.getElementById('fullNameValue').innerText,
                email: document.getElementById('emailValue').innerText,
                phone: document.getElementById('phoneValue').innerText,
                description: document.getElementById('descriptionValue').innerText
            };

            // إخفاء القيم وإظهار الحقول
            ['username', 'fullName', 'email', 'phone', 'description'].forEach(field => {
                document.getElementById(field + 'Value').style.display = 'none';
                document.getElementById(field + 'Input').style.display = 'block';
            });

            document.getElementById('personalEditActions').style.display = 'flex';
        }
    }

    function cancelEdit(section) {
        if (section === 'personal') {
            // استعادة القيم
            ['username', 'fullName', 'email', 'phone', 'description'].forEach(field => {
                document.getElementById(field + 'Value').innerText = originalValues[field];
                document.getElementById(field + 'Value').style.display = 'block';
                document.getElementById(field + 'Input').style.display = 'none';
            });

            document.getElementById('personalEditActions').style.display = 'none';
        }
    }

    async function savePersonalInfo() {
        const data = {
            username: document.getElementById('usernameInput').value,
            fullName: document.getElementById('fullNameInput').value,
            email: document.getElementById('emailInput').value,
            phoneNumber: document.getElementById('phoneInput').value,
            description: document.getElementById('descriptionInput').value
        };

        try {
            const response = await fetch('/Account/UpdateProfile', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                Swal.fire({
                    title: 'تم!',
                    text: 'تم حفظ التغييرات بنجاح',
                    icon: 'success',
                    confirmButtonText: 'حسناً'
                }).then(() => location.reload());
            } else {
                Swal.fire({
                    title: 'خطأ',
                    text: 'حدث خطأ في حفظ التغييرات',
                    icon: 'error',
                    confirmButtonText: 'حسناً'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'خطأ',
                text: 'حدث خطأ في حفظ التغييرات',
                icon: 'error',
                confirmButtonText: 'حسناً'
            });
        }
    }

    function verifyEmail() {
        Swal.fire({
            title: 'التحقق من البريد',
            text: 'سيتم إرسال رابط التحقق إلى بريدك الإلكتروني',
            icon: 'info',
            confirmButtonText: 'حسناً'
        });
    }

    // ربط الأحداث
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.edit-section-btn').forEach(btn => {
            btn.addEventListener('click', () => editSection('personal'));
        });

        document.getElementById('editProfileBtn')?.addEventListener('click', () => editSection('personal'));

        // Modal
        const avatarModal = document.getElementById('avatarModal');
        document.getElementById('changeAvatarBtn')?.addEventListener('click', () => {
            if (avatarModal) avatarModal.style.display = 'flex';
        });

        document.querySelectorAll('.avatar-option').forEach(option => {
            option.addEventListener('click', () => {
                const avatar = option.getAttribute('data-avatar');
                document.querySelector('.profile-avatar span')?.remove();
                const avatarElement = document.querySelector('.profile-avatar');
                avatarElement.innerHTML = `<span>${avatar}</span>`;
                if (avatarModal) avatarModal.style.display = 'none';
            });
        });

        document.querySelector('.close-modal-btn')?.addEventListener('click', () => {
            if (avatarModal) avatarModal.style.display = 'none';
        });
    });
</script>
@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#210057" />
    <title>@ViewData["Title"] - سومر</title>

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <style>
        :root {
            --primary-color: #210057;
            --primary-dark: #180040;
            --icon-color: #9496a5;
            --text-color: #333;
            --white: #fff;
            --light-bg: #f8f9fc;
            --border-color: #e8eaf0;
            --safe-area-top: env(safe-area-inset-top, 0px);
            --safe-area-bottom: env(safe-area-inset-bottom, 0px);
            --safe-area-left: env(safe-area-inset-left, 0px);
            --safe-area-right: env(safe-area-inset-right, 0px);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            height: 100dvh;
            overflow: hidden;
            font-family: 'Tajawal', 'Cairo', sans-serif;
            background: var(--primary-color);
            position: relative;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* ==========================================
                   منطقة الصور - 65% من الشاشة
                   ========================================== */
        .slideshow-container {
            position: relative;
            width: 100%;
            height: 65%;
            height: 65dvh;
            overflow: hidden;
            background: var(--primary-color);
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .slide.active {
                opacity: 1;
            }

            .slide img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                -webkit-user-drag: none;
                pointer-events: none;
            }

            /* تدرج لوني فوق الصور */
            .slide::after {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient( to bottom, rgba(33, 0, 87, 0.3) 0%, rgba(33, 0, 87, 0.6) 50%, rgba(33, 0, 87, 0.9) 100% );
                pointer-events: none;
            }

        /* محتوى فوق الصور */
        .slideshow-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 2;
            width: 90%;
            max-width: 500px;
            padding: 20px;
        }

            .slideshow-content .app-icon {
                width: 80px;
                height: 80px;
                background: rgba(255, 255, 255, 0.2);
                border-radius: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                border: 2px solid rgba(255, 255, 255, 0.3);
                backdrop-filter: blur(10px);
            }

                .slideshow-content .app-icon i {
                    font-size: 40px;
                    color: var(--white);
                }

            .slideshow-content h1 {
                color: var(--white);
                font-size: 2rem;
                font-weight: 900;
                margin-bottom: 8px;
                text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            }

            .slideshow-content p {
                color: rgba(255, 255, 255, 0.9);
                font-size: 1rem;
                font-weight: 500;
                text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
            }

        /* مؤشرات النقاط */
        .slide-indicators {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 3;
        }

        .slide-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
            transition: all 0.3s ease;
        }

            .slide-indicator.active {
                background: var(--white);
                width: 24px;
                border-radius: 4px;
            }

        /* ==========================================
                   منطقة الأزرار - 35% من الشاشة
                   ========================================== */
        .auth-actions {
            position: relative;
            width: 100%;
            height: 35%;
            height: 35dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 20px;
            background: var(--light-bg);
            border-radius: 30px 30px 0 0;
            margin-top: -30px;
            z-index: 10;
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.2);
        }

        .auth-buttons {
            width: 100%;
            max-width: 400px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-auth {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Tajawal', 'Cairo', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
        }

        .btn-login {
            background: var(--primary-color);
            color: var(--white);
            box-shadow: 0 4px 12px rgba(33, 0, 87, 0.3);
        }

            .btn-login:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(33, 0, 87, 0.4);
            }

            .btn-login:active {
                transform: translateY(0);
                box-shadow: 0 2px 8px rgba(33, 0, 87, 0.3);
            }

        .btn-register {
            background: var(--white);
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
        }

            .btn-register:hover {
                background: #f0ebf8;
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(33, 0, 87, 0.2);
            }

            .btn-register:active {
                transform: translateY(0);
            }

        .btn-auth i {
            font-size: 1.2rem;
        }

        /* تأثير ripple */
        .btn-auth::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn-auth:active::after {
            width: 300px;
            height: 300px;
        }

        /* ==========================================
                   مودال تسجيل الدخول
                   ========================================== */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 1000;
            display: none;
            align-items: flex-end;
            justify-content: center;
            animation: fadeIn 0.3s ease;
        }

            .modal-overlay.show {
                display: flex;
            }

        .modal-content {
            background: var(--white);
            width: 100%;
            max-width: 500px;
            max-height: 90vh;
            border-radius: 30px 30px 0 0;
            padding: 24px 20px;
            overflow-y: auto;
            animation: slideUp 0.3s ease-out;
            position: relative;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

            .modal-header h2 {
                color: var(--text-color);
                font-size: 1.5rem;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                .modal-header h2 i {
                    color: var(--primary-color);
                }

        .btn-close-modal {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--light-bg);
            color: var(--icon-color);
            font-size: 1.2rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

            .btn-close-modal:hover {
                background: #fee2e2;
                color: #dc2626;
            }

        /* حقول الإدخال */
        .form-group {
            margin-bottom: 20px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--icon-color);
            font-size: 1rem;
            pointer-events: none;
            transition: color 0.3s;
        }

        .input-field {
            width: 100%;
            padding: 14px 45px 14px 16px;
            font-size: 1rem;
            font-family: 'Tajawal', 'Cairo', sans-serif;
            border: 2px solid var(--border-color);
            border-radius: 14px;
            transition: all 0.3s;
            background: var(--light-bg);
            color: var(--text-color);
            -webkit-user-select: text;
            user-select: text;
        }

            .input-field:focus {
                outline: none;
                border-color: var(--primary-color);
                background: var(--white);
                box-shadow: 0 0 0 4px rgba(33, 0, 87, 0.1);
            }

                .input-field:focus + .input-icon {
                    color: var(--primary-color);
                }

        .toggle-password {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--icon-color);
            font-size: 1rem;
            transition: color 0.3s;
            background: none;
            border: none;
        }

            .toggle-password:hover {
                color: var(--primary-color);
            }

        /* رسائل الخطأ */
        .validation-error {
            color: #dc2626;
            font-size: 0.75rem;
            display: block;
            margin-top: 4px;
        }

        .alert-danger {
            background-color: #fee2e2;
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 0.875rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* خيارات إضافية */
        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            font-size: 0.875rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-color);
        }

            .checkbox-label input {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: var(--primary-color);
            }

        .forgot-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }

        /* زر تأكيد تسجيل الدخول */
        .btn-submit {
            width: 100%;
            padding: 14px;
            background: var(--primary-color);
            color: var(--white);
            border: none;
            border-radius: 14px;
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Tajawal', 'Cairo', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .btn-submit:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(33, 0, 87, 0.3);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

        /* ==========================================
                   حركات
                   ========================================== */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
        }

        to {
            opacity: 1;
        }

        }

        @@keyframes slideUp {
            from

        {
            transform: translateY(100%);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }

        }

        @@keyframes zoomIn {
            from

        {
            transform: scale(0.9);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }

        }

        /* ==========================================
                   استجابة للشاشات
                   ========================================== */
        @@media (max-height: 600px) {
            .slideshow-container

        {
            height: 55%;
            height: 55dvh;
        }

        .auth-actions {
            height: 45%;
            height: 45dvh;
            padding: 12px;
            gap: 10px;
        }

        .slideshow-content .app-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            margin-bottom: 10px;
        }

            .slideshow-content .app-icon i {
                font-size: 24px;
            }

        .slideshow-content h1 {
            font-size: 1.5rem;
        }

        .btn-auth {
            padding: 12px;
            font-size: 0.9rem;
        }

        }

        @@media (min-height: 800px) {
            .btn-auth

        {
            padding: 20px;
            font-size: 1.2rem;
        }

        .auth-buttons {
            gap: 16px;
        }

        }

        /* دعم Notch */
        @@supports (padding: max(0px)) {
            .auth-actions

        {
            padding-bottom: max(20px, env(safe-area-inset-bottom));
        }

        }
    </style>
</head>
<body>
    <!-- منطقة الصور - 65% -->
    <div class="slideshow-container">
        <!-- الصور -->
        <div class="slide active">
            <img src="/images/slide1.jpg" alt="تعليم">
        </div>
        <div class="slide">
            <img src="/images/slide2.jpg" alt="أساتذة">
        </div>
        <div class="slide">
            <img src="/images/slide3.jpg" alt="كورسات">
        </div>
        <div class="slide">
            <img src="/images/slide4.jpg" alt="تعلم">
        </div>

        <!-- محتوى فوق الصور -->
        <div class="slideshow-content">
            <div class="app-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <h1>منصة سومر</h1>
            <p>تعلم مع أفضل الأساتذة المتميزين</p>
        </div>

        <!-- مؤشرات -->
        <div class="slide-indicators">
            <div class="slide-indicator active"></div>
            <div class="slide-indicator"></div>
            <div class="slide-indicator"></div>
            <div class="slide-indicator"></div>
        </div>
    </div>

    <!-- منطقة الأزرار - 35% -->
    <div class="auth-actions">
        <div class="auth-buttons">
            <button class="btn-auth btn-login" onclick="openLoginModal()">
                <i class="fas fa-sign-in-alt"></i>
                <span>تسجيل الدخول</span>
            </button>
            <button class="btn-auth btn-register" onclick="openRegisterModal()">
                <i class="fas fa-user-plus"></i>
                <span>إنشاء حساب جديد</span>
            </button>
        </div>
    </div>

    <!-- مودال تسجيل الدخول -->
    <div class="modal-overlay" id="loginModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>
                    <i class="fas fa-sign-in-alt"></i>
                    تسجيل الدخول
                </h2>
                <button class="btn-close-modal" onclick="closeLoginModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-danger">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>@ViewData.ModelState[string.Empty].Errors.First().ErrorMessage</span>
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-group">
                    <div class="input-wrapper">
                        <input asp-for="Email" class="input-field" placeholder="البريد الإلكتروني" type="email" autocomplete="email" />
                        <i class="fas fa-envelope input-icon"></i>
                    </div>
                    <span asp-validation-for="Email" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <div class="input-wrapper">
                        <input asp-for="Password" class="input-field" placeholder="كلمة المرور" type="password" id="password" />
                        <i class="fas fa-lock input-icon"></i>
                        <button type="button" class="toggle-password" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-options">
                    <label class="checkbox-label">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>تذكرني</span>
                    </label>
                    <a href="#" class="forgot-link">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>تسجيل الدخول</span>
                </button>
            </form>
        </div>
    </div>

    <!-- مودال إنشاء حساب -->
    <div class="modal-overlay" id="registerModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>
                    <i class="fas fa-user-plus"></i>
                    إنشاء حساب جديد
                </h2>
                <button class="btn-close-modal" onclick="closeRegisterModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <p style="text-align: center; color: var(--icon-color); font-size: 1rem;">
                سيتم توجيهك لصفحة إنشاء الحساب
            </p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ==========================================
        // عرض الصور المتغيرة تلقائياً
        // ==========================================
        const slides = document.querySelectorAll('.slide');
        const indicators = document.querySelectorAll('.slide-indicator');
        let currentSlide = 0;
        let slideInterval;

        function showSlide(index) {
            slides.forEach(slide => slide.classList.remove('active'));
            indicators.forEach(indicator => indicator.classList.remove('active'));

            slides[index].classList.add('active');
            indicators[index].classList.add('active');
            currentSlide = index;
        }

        function nextSlide() {
            const next = (currentSlide + 1) % slides.length;
            showSlide(next);
        }

        function startSlideshow() {
            slideInterval = setInterval(nextSlide, 4000);
        }

        function stopSlideshow() {
            clearInterval(slideInterval);
        }

        // بدء عرض الصور
        startSlideshow();

        // ==========================================
        // فتح/إغلاق المودالات
        // ==========================================
        function openLoginModal() {
            document.getElementById('loginModal').classList.add('show');
            document.body.style.overflow = 'hidden';
            stopSlideshow();
        }

        function closeLoginModal() {
            document.getElementById('loginModal').classList.remove('show');
            document.body.style.overflow = '';
            startSlideshow();
        }

        function openRegisterModal() {
            document.getElementById('registerModal').classList.add('show');
            document.body.style.overflow = 'hidden';
            stopSlideshow();

            // توجيه لصفحة التسجيل بعد ثانية
            setTimeout(() => {
                window.location.href = '/Account/Register';
            }, 1500);
        }

        function closeRegisterModal() {
            document.getElementById('registerModal').classList.remove('show');
            document.body.style.overflow = '';
            startSlideshow();
        }

        // إغلاق المودال عند النقر خارج المحتوى
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                    document.body.style.overflow = '';
                    startSlideshow();
                }
            });
        });

        // ==========================================
        // إظهار/إخفاء كلمة المرور
        // ==========================================
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');

        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);

                const icon = this.querySelector('i');
                icon.classList.toggle('fa-eye');
                icon.classList.toggle('fa-eye-slash');
            });
        }

        // ==========================================
        // تحسين تجربة الإدخال
        // ==========================================
        document.querySelectorAll('.input-field').forEach(input => {
            input.addEventListener('focus', function() {
                const icon = this.parentElement.querySelector('.input-icon');
                if (icon) {
                    icon.style.color = '#210057';
                }
            });

            input.addEventListener('blur', function() {
                const icon = this.parentElement.querySelector('.input-icon');
                if (icon) {
                    icon.style.color = '#9496a5';
                }
            });
        });

        // فتح مودال تسجيل الدخول تلقائياً إذا كان هناك خطأ
        @if (!ViewData.ModelState.IsValid)
        {
                <text>
                document.addEventListener('DOMContentLoaded', function() {
                    openLoginModal();
                });
                </text>
        }
    </script>
</body>
</html>
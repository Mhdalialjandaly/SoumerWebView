@model MyCoursesViewModel


<div class="container-fluid mt-4" dir="rtl">
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalEnrolled</div>
                <div>كورس مسجل</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-card">
                <div class="stats-number">@Model.TotalSpent.ToString("N0")</div>
                <div>نقطة منفقة</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-card">
                <div class="stats-number">📚</div>
                <div>كورساتي</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">📖 الكورسات المسجل فيها</h5>
        </div>
        <div class="card-body">
            @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
            {
                foreach (var enrollment in Model.EnrolledCourses)
                {
                    <div class="course-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">@enrollment.Course.Name</h5>
                                <small class="text-muted">تاريخ التسجيل: @enrollment.CreatedAt.ToString("yyyy/MM/dd")</small>
                            </div>
                            <div>
                                <span class="badge bg-success">@enrollment.Course.Price.ToString("N0") نقطة</span>
                                <a href="/Course/Details/@enrollment.CourseId" class="btn btn-sm btn-outline-primary ms-2">
                                    عرض التفاصيل
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">لم تسجل في أي كورس بعد</p>
                    <a href="/Course/Index" class="btn btn-primary">
                        استعرض الكورسات
                    </a>
                </div>
            }
        </div>
    </div>
</div>
@model MyCoursesViewModel

<div class="container-fluid mt-4" dir="rtl">
    <!-- بطاقات الإحصائيات -->
    <div class="stats-grid">
        <div class="stat-card stat-card-primary">
            <div class="stat-card-icon">📚</div>
            <div class="stat-card-content">
                <div class="stat-card-number">@Model.TotalEnrolled</div>
                <div class="stat-card-label">كورس مسجل</div>
            </div>
        </div>

        <div class="stat-card stat-card-success">
            <div class="stat-card-icon">💎</div>
            <div class="stat-card-content">
                <div class="stat-card-number">@Model.TotalSpent.ToString("N0")</div>
                <div class="stat-card-label">نقطة منفقة</div>
            </div>
        </div>

        <div class="stat-card stat-card-info">
            <div class="stat-card-icon">🎓</div>
            <div class="stat-card-content">
                <div class="stat-card-number">@Model.TotalEnrolled</div>
                <div class="stat-card-label">كورساتي</div>
            </div>
        </div>
    </div>

    <!-- قائمة الكورسات المسجلة مع الفيديوهات -->
    <div class="courses-list-card">
        <div class="card-header-custom">
            <div class="header-icon">📖</div>
            <h5 class="header-title">الكورسات المسجل فيها</h5>
            <span class="header-badge">@Model.TotalEnrolled كورس</span>
        </div>

        <div class="card-body-custom">
            @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
            {
                <div class="courses-list">
                    @foreach (var enrollment in Model.EnrolledCourses)
                    {
                        var videosCount = Model.CourseVideosCount.ContainsKey(enrollment.CourseId) ? Model.CourseVideosCount[enrollment.CourseId] : 0;
                        var videos = Model.CourseVideos.ContainsKey(enrollment.CourseId) ? Model.CourseVideos[enrollment.CourseId] : new List<CourseVideoDto>();

                        <div class="course-item-card">
                            <div class="course-item-content">
                                <div class="course-item-icon">📘</div>
                                <div class="course-item-info">
                                    <h5 class="course-item-title">@enrollment.Course.Name</h5>
                                    <div class="course-item-meta">
                                        <span class="meta-date">
                                            📅 تاريخ التسجيل: @enrollment.CreatedAt.ToString("yyyy/MM/dd")
                                        </span>
                                        <span class="meta-price">
                                            💎 @enrollment.Course.Price.ToString("N0") نقطة
                                        </span>
                                        <span class="meta-videos">
                                            🎬 @videosCount فيديو
                                        </span>
                                    </div>
                                </div>
                                <div class="course-item-actions">
                                    <a href="/Course/Details/@enrollment.CourseId" class="btn-action">
                                        عرض التفاصيل
                                        <span>→</span>
                                    </a>
                                    @* <button onclick="showCourseVideos(@enrollment.CourseId, '@enrollment.Course.Name.Replace("'", "\\'")')"
                                            class="btn-watch-videos">
                                        <span>🎬</span> مشاهدة الفيديوهات
                                        <span>→</span>
                                    </button> *@
                                    <button onclick="window.location.href='/Course/CourseVideos?courseId=@enrollment.CourseId'"
                                            class="btn-watch-videos">
                                        <span>🎬</span>مشاهدة الفيديوهات  
                                        <span>→</span>
                                    </button>
                                </div>
                            </div>

                            <!-- عرض معاينة الفيديوهات (اختياري) -->
                            @if (videos.Any() && videosCount > 0)
                            {
                                <div class="course-videos-preview">
                                    <div class="preview-header">
                                        <span>📹 أحدث الفيديوهات</span>
                                    </div>
                                    <div class="preview-videos">
                                        @foreach (var video in videos.Take(3))
                                        {
                                            <div class="preview-video-item" onclick="playVideo(@video.Id)">
                                                <div class="preview-thumbnail">
                                                    <img src="@(video.Platform == VideoPlatform.YouTube ? $"https://img.youtube.com/vi/{video.VideoId}/default.jpg" : video.EmbedUrl ?? "/images/video-placeholder.jpg")"
                                                         alt="@video.Title">
                                                    <div class="play-icon">▶️</div>
                                                </div>
                                                <div class="preview-info">
                                                    <div class="preview-title">@video.Title</div>
                                                    <div class="preview-duration">@(video.Duration > 0 ? $"{video.Duration / 60}:{video.Duration % 60:D2}" : "")</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-courses">
                    <div class="empty-icon">📚</div>
                    <p class="empty-title">لم تسجل في أي كورس بعد</p>
                    <p class="empty-description">ابدأ رحلتك التعليمية الآن</p>
                    <a href="/Course/Index" class="btn-browse-courses">
                        استعرض الكورسات
                        <span>→</span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal لعرض الفيديوهات -->
<div id="videosModal" class="modal-videos" style="display: none;">
    <div class="modal-videos-content">
        <div class="modal-videos-header">
            <h3 id="modalCourseTitle"></h3>
            <button class="close-modal-videos" onclick="closeVideosModal()">✕</button>
        </div>
        <div class="modal-videos-body" id="videosListContainer">
            <!-- سيتم تحميل الفيديوهات هنا -->
        </div>
    </div>
</div>

<!-- Modal لعرض الفيديو -->
<div id="videoPlayerModal" class="modal-video-player" style="display: none;">
    <div class="modal-video-player-content">
        <div class="modal-video-player-header">
            <h3 id="videoTitle"></h3>
            <button class="close-video-player" onclick="closeVideoPlayer()">✕</button>
        </div>
        <div class="modal-video-player-body">
            <div id="videoFrameContainer" class="video-frame-container">
                <!-- سيتم تحميل الفيديو هنا -->
            </div>
            <div class="video-info">
                <p id="videoDescription"></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // عرض فيديوهات الكورس
        async function showCourseVideos(courseId, courseName) {
            try {
                // عرض مؤشر تحميل
                Swal.fire({
                    title: 'جاري التحميل...',
                    text: 'يتم جلب فيديوهات الكورس',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // التصحيح: تغيير المسار من /Course/ إلى /Home/
                const response = await fetch(`/Home/GetCourseVideos?courseId=${courseId}`);
                const data = await response.json();

                Swal.close();

                if (data.success && data.videos && data.videos.length > 0) {
                    displayVideosModal(courseName, data.videos);
                } else {
                    Swal.fire({
                        title: 'لا توجد فيديوهات',
                        text: data.message || 'لم يتم إضافة فيديوهات لهذا الكورس بعد',
                        icon: 'info',
                        confirmButtonText: 'حسناً'
                    });
                }
            } catch (error) {
                Swal.close();
                console.error('Error fetching videos:', error);
                Swal.fire('خطأ', 'حدث خطأ في تحميل الفيديوهات', 'error');
            }
        }

        function displayVideosModal(courseName, videos) {
            const modal = document.getElementById('videosModal');
            const modalTitle = document.getElementById('modalCourseTitle');
            const videosContainer = document.getElementById('videosListContainer');

            if (!modal || !modalTitle || !videosContainer) {
                console.error('Modal elements not found');
                return;
            }

            modalTitle.textContent = `📺 ${courseName} - قائمة الفيديوهات (${videos.length} فيديو)`;

            // تجميع الفيديوهات حسب الترتيب
            const sortedVideos = [...videos].sort((a, b) => (a.order || 0) - (b.order || 0));

            videosContainer.innerHTML = `
                <div class="videos-list-modal">
                    ${sortedVideos.map(video => {
                        // تحديد الصورة المصغرة
                        let thumbnailUrl = '/images/video-placeholder.jpg';
                        if (video.platform === 1) { // YouTube
                            thumbnailUrl = `https://img.youtube.com/vi/${video.videoId}/mqdefault.jpg`;
                        } else if (video.platform === 2 && video.videoId) { // Vimeo
                            thumbnailUrl = `https://vumbnail.com/${video.videoId}.jpg`;
                        }

                        return `
                            <div class="video-item-modal" onclick="playVideo(${video.id})">
                                <div class="video-thumbnail-modal">
                                    <img src="${thumbnailUrl}"
                                         alt="${escapeHtml(video.title)}"
                                         onerror="this.src='/images/video-placeholder.jpg'">
                                    ${video.duration && video.duration > 0 ? `
                                        <div class="video-duration-badge">
                                            ${Math.floor(video.duration / 60)}:${(video.duration % 60).toString().padStart(2, '0')}
                                        </div>
                                    ` : ''}
                                    <div class="play-overlay">▶️</div>
                                </div>
                                <div class="video-info-modal">
                                    <div class="video-order-badge">#${video.order || 0}</div>
                                    <h4>${escapeHtml(video.title)}</h4>
                                    <p>${escapeHtml(video.description ? (video.description.length > 100 ? video.description.substring(0, 100) + '...' : video.description) : 'لا يوجد وصف')}</p>
                                    <div class="video-meta">
                                        <span class="platform-badge">
                                            ${video.platform === 1 ? '📺 يوتيوب' : '🎬 فيميو'}
                                        </span>
                                        ${video.isFree ?
                                            '<span class="free-badge">🎁 مجاني</span>' :
                                            '<span class="premium-badge">💎 مدفوع</span>'
                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('')}
                </div>
            `;

            // عرض المودال
            modal.style.display = 'flex';
            modal.style.animation = 'fadeIn 0.2s ease';
        }
        // دالة للحصول على الصورة المصغرة للفيديو
        function getVideoThumbnail(video) {
            if (video.platform === 1) { // YouTube
                return `https://img.youtube.com/vi/${video.videoId}/mqdefault.jpg`;
            } else if (video.platform === 2) { // Vimeo
                return video.thumbnailUrl || `https://vumbnail.com/${video.videoId}.jpg`;
            }
            return '/images/video-placeholder.jpg';
        }

        // دالة لتنسيق المدة
        function formatDuration(seconds) {
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
        }

        // دالة للحصول على أيقونة المنصة
        function getPlatformIcon(platform) {
            return platform === 1 ? '📺' : '🎬';
        }
        function closeVideosModal() {
            document.getElementById('videosModal').style.display = 'none';
        }

               async function playVideo(videoId) {
            try {
                // عرض مؤشر تحميل
                Swal.fire({
                    title: 'جاري التحميل...',
                    text: 'يتم تجهيز الفيديو للتشغيل',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // التصحيح: تغيير المسار من /Course/ إلى /Home/
                const response = await fetch(`/Home/GetVideoDetails?videoId=${videoId}`);
                const data = await response.json();

                Swal.close();

                if (data.success) {
                    // إغلاق مودال الفيديوهات إذا كان مفتوحاً
                    closeVideosModal();
                    openVideoPlayer(data.video);
                } else {
                    Swal.fire({
                        title: 'لا يمكن تشغيل الفيديو',
                        text: data.message || 'حدث خطأ في تشغيل الفيديو',
                        icon: 'error',
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#ef4444'
                    });
                }
            } catch (error) {
                Swal.close();
                console.error('Error playing video:', error);
                Swal.fire({
                    title: 'خطأ',
                    text: 'حدث خطأ في تشغيل الفيديو. يرجى المحاولة مرة أخرى',
                    icon: 'error',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#ef4444'
                });
            }
        }

        function openVideoPlayer(video) {
            const modal = document.getElementById('videoPlayerModal');
            const title = document.getElementById('videoTitle');
            const description = document.getElementById('videoDescription');
            const container = document.getElementById('videoFrameContainer');

            if (!modal || !title || !description || !container) {
                console.error('Video player modal elements not found');
                return;
            }

            title.textContent = video.title || 'فيديو تعليمي';
            description.textContent = video.description || 'لا يوجد وصف';

            // إنشاء iframe لتشغيل الفيديو
            let embedUrl = '';

            if (video.platform === 1) { // YouTube
                // استخدام embed URL من قاعدة البيانات أو إنشاؤه
                embedUrl = video.embedUrl || `https://www.youtube.com/embed/${video.videoId}`;
                // إضافة معلمات محسنة
                if (!embedUrl.includes('?')) {
                    embedUrl += '?autoplay=1&rel=0&modestbranding=1&showinfo=0&controls=1&fs=1';
                } else {
                    embedUrl += '&autoplay=1&rel=0&modestbranding=1&showinfo=0&controls=1&fs=1';
                }
            } else if (video.platform === 2) { // Vimeo
                embedUrl = video.embedUrl || `https://player.vimeo.com/video/${video.videoId}`;
                if (!embedUrl.includes('?')) {
                    embedUrl += '?autoplay=1&title=0&byline=0&portrait=0&badge=0';
                } else {
                    embedUrl += '&autoplay=1&title=0&byline=0&portrait=0&badge=0';
                }
            }

            container.innerHTML = `
                <iframe src="${embedUrl}"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        style="width: 100%; height: 100%;">
                </iframe>
            `;

            modal.style.display = 'flex';
            modal.style.animation = 'fadeIn 0.2s ease';

            // حفظ الفيديو الحالي للتتبع
            currentPlayingVideo = video;

            // بدء تتبع وقت المشاهدة
            startWatchTracking();
        }


        let currentPlayingVideo = null;
        let watchInterval = null;

        function startWatchTracking() {
            // إيقاف التتبع السابق إذا كان موجوداً
            if (watchInterval) {
                clearInterval(watchInterval);
            }

            // بدء تتبع جديد كل 10 ثواني
            watchInterval = setInterval(() => {
                if (currentPlayingVideo) {
                    saveVideoProgress(currentPlayingVideo.id);
                }
            }, 10000);
        }

        async function saveVideoProgress(videoId) {
            try {
                // يمكن إضافة تتبع التقدم هنا
                await fetch('/Course/SaveVideoProgress', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                    },
                    body: JSON.stringify({
                        videoId: videoId,
                        progress: 0, // يمكن جلب التقدم من iframe إذا كان مدعوماً
                        watchTime: 0
                    })
                });
            } catch (error) {
                console.error('Error saving progress:', error);
            }
        }

        function stopWatchTracking() {
            if (watchInterval) {
                clearInterval(watchInterval);
                watchInterval = null;
            }
        }

        function closeVideoPlayer() {
            const modal = document.getElementById('videoPlayerModal');
            const container = document.getElementById('videoFrameContainer');

            // إيقاف تتبع المشاهدة
            stopWatchTracking();
            currentPlayingVideo = null;

            // إفراغ المحتوى لإيقاف الفيديو
            container.innerHTML = '';
            modal.style.display = 'none';
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // إغلاق المودال عند الضغط خارج المحتوى
        window.onclick = function(event) {
            const videosModal = document.getElementById('videosModal');
            const videoPlayerModal = document.getElementById('videoPlayerModal');

            if (event.target === videosModal) {
                closeVideosModal();
            }
            if (event.target === videoPlayerModal) {
                closeVideoPlayer();
            }
        }
    </script>
}
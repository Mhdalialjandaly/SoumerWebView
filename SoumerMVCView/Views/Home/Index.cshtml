@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="home-page">
    <!-- ==========================================
         السلايدر العلوي - 50% من الشاشة
         ========================================== -->
    <div class="hero-slider">
        <div class="hero-slider-header">
            <h1>
                <span>🏆</span>
                أفضل الأساتذة
            </h1>
            <span class="badge">مميزون</span>
        </div>

        <div class="hero-slider-container" id="heroSliderContainer">
            @if (Model.FeaturedTeachers != null && Model.FeaturedTeachers.Any())
            {
                var teacherIndex = 0;
                @foreach (var teacher in Model.FeaturedTeachers.Take(6))
                {
                    <div class="hero-slide @(teacherIndex == 0 ? "active" : "")" data-teacher-id="@teacher.Id">
                        <div class="hero-slide-bg">
                            <img src="@(string.IsNullOrEmpty(teacher.Image) ? "/images/default-avatar.png" : teacher.Image)" alt="@teacher.Name">
                        </div>
                        <div class="hero-slide-content">
                            <div class="hero-teacher-avatar">
                                <img src="@(string.IsNullOrEmpty(teacher.Image) ? "/images/default-avatar.png" : teacher.Image)" alt="@teacher.Name">
                            </div>
                            <h2 class="hero-slide-title">@teacher.Name</h2>
                            <p class="hero-slide-subtitle">@teacher.Subject</p>
                            <span class="hero-slide-badge">
                                <i class="fas fa-star"></i>
                                أستاذ متميز
                            </span>
                        </div>
                    </div>
                    teacherIndex++;
                }
            }
            else
            {
                <div class="hero-slide active">
                    <div class="hero-slide-content">
                        <div class="hero-teacher-avatar" style="background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-graduation-cap" style="font-size: 3rem; color: #fff;"></i>
                        </div>
                        <h2 class="hero-slide-title">منصة سومر</h2>
                        <p class="hero-slide-subtitle">تعلم مع أفضل الأساتذة</p>
                    </div>
                </div>
            }
        </div>

        <!-- مؤشرات السلايدر -->
        <div class="hero-slider-indicators" id="heroSliderIndicators">
            @if (Model.FeaturedTeachers != null && Model.FeaturedTeachers.Any())
            {
                var indicatorIndex = 0;
                @foreach (var teacher in Model.FeaturedTeachers.Take(6))
                {
                    <div class="hero-slider-indicator @(indicatorIndex == 0 ? "active" : "")" data-slide="@indicatorIndex"></div>
                    indicatorIndex++;
                }
            }
        </div>
    </div>

    <!-- ==========================================
         قسم المراحل الدراسية
         ========================================== -->
    <div class="grades-section" id="gradesSection">
        <div class="grades-header">
            <span class="grades-count">
                @(Model.GradesTeachers?.Count ?? 0) مرحلة
            </span>
            <span class="grades-count">
                @(Model.GradesTeachers?.SelectMany(e => e.Teachers).Count() ?? 0) أستاذ
            </span>
        </div>

        <div class="grades-grid" id="gradesGrid">
            @if (Model.GradesTeachers != null && Model.GradesTeachers.Any())
            {
                @foreach (var grade in Model.GradesTeachers)
                {
                    <div class="grade-card grade-@grade.Grade" data-grade="@grade.Grade" onclick="showGradeTeachers(@grade.Grade)">
                        <div class="grade-icon">
                            <i class="fas fa-book-open"></i>
                        </div>

                        <!-- ✅ عرض اسم المرحلة بدلاً من الرقم -->
                        <div class="grade-number">
                            @(string.IsNullOrWhiteSpace(grade.GradeLevel)
                                                ? $"الصف {grade.Grade} {grade.GradeName}"
                                                : $"الصف {grade.GradeName} {grade.GradeLevel} ")
                </div>

                        <div class="grade-level">
                            @grade.Grade مستوى
                        </div>

                        <div class="grade-actions">
                            <button type="button"
                                    class="grade-action-btn"
                                    onclick="event.stopPropagation(); showGradeTeachers(@grade.Grade)"
                                    title="عرض الأساتذة">
                                <i class="fas fa-chalkboard-teacher"></i>
                                <span>@grade.Teachers.Count</span>
                            </button>
                            <button type="button"
                                    class="grade-action-btn grade-action-btn-courses"
                                    onclick="event.stopPropagation(); showGradeCourses(@grade.Grade)"
                                    title="عرض المواد">
                                <i class="fas fa-book"></i>
                                <span>المواد</span>
                            </button>
                        </div>
                    </div>
                        }
            }
            else
            {
                <div style="grid-column: 1/-1; text-align: center; padding: 40px; color: #9496a5;">
                    لا توجد مراحل دراسية حالياً
                </div>
            }
        </div>
    </div>
</div>

<!-- ==========================================
     مودال عرض أساتذة المرحلة
     ========================================== -->
<div class="teachers-modal-overlay" id="teachersModalOverlay">
    <div class="teachers-modal">
        <div class="teachers-modal-header">
            <h3 class="teachers-modal-title" id="modalTitle">
                <span>👨‍🏫</span>
                أساتذة المرحلة
            </h3>
            <button class="teachers-modal-close" onclick="closeTeachersModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="teachers-list" id="teachersList">
            <!-- سيتم ملؤها بواسطة JavaScript -->
        </div>
    </div>
</div>

<!-- ==========================================
     مودال عرض مواد المرحلة
     ========================================== -->
<div class="teachers-modal-overlay" id="coursesModalOverlay">
    <div class="teachers-modal">
        <div class="teachers-modal-header">
            <h3 class="teachers-modal-title" id="coursesModalTitle">
                <span>📚</span>
                مواد المرحلة
            </h3>
            <button class="teachers-modal-close" onclick="closeCoursesModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="teachers-list" id="coursesList">
            <!-- سيتم ملؤها بواسطة JavaScript -->
        </div>
    </div>
</div>

<style>
    /* ==========================================
           تنسيقات بطاقة المرحلة - دعم الاسم العربي الكامل
           ========================================== */
    .grade-number {
        font-size: 0.95rem;
        font-weight: 800;
        color: #333;
        margin-bottom: 4px;
        line-height: 1.3;
        min-height: 2.4em;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0 4px;
    }

    .grade-level {
        font-size: 0.68rem;
        color: #9496a5;
        margin-bottom: 8px;
        line-height: 1.2;
    }

    /* أزرار داخل بطاقة المرحلة */
    .grade-actions {
        display: flex;
        gap: 4px;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px dashed #e8eaf0;
    }

    .grade-action-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 5px 6px;
        border-radius: 8px;
        border: 1px solid #e8eaf0;
        background: #f8f9fc;
        color: #210057;
        font-size: 0.65rem;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .grade-action-btn i {
            font-size: 0.7rem;
        }

        .grade-action-btn:hover {
            background: #210057;
            color: #fff;
            border-color: #210057;
            transform: translateY(-1px);
        }

        .grade-action-btn:active {
            transform: scale(0.95);
        }

    .grade-action-btn-courses {
        background: #fffbeb;
        color: #b45309;
        border-color: #fde68a;
    }

        .grade-action-btn-courses:hover {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #fff;
            border-color: #d97706;
        }

    /* ==========================================
           بطاقة مادة داخل مودال المواد
           ========================================== */
    .grade-course-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #f8f9fc;
        border-radius: 14px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-bottom: 8px;
    }

        .grade-course-item:hover {
            background: #f0ebf8;
            border-color: #210057;
            transform: translateX(-4px);
        }

        .grade-course-item.is-enrolled {
            border-color: #a7f3d0;
            background: #ecfdf5;
        }

    .grade-course-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f0ebf8;
        color: #210057;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .grade-course-item.is-enrolled .grade-course-icon {
        background: #d1fae5;
        color: #059669;
    }

    .grade-course-info {
        flex: 1;
        min-width: 0;
    }

    .grade-course-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 3px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .grade-course-meta {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.7rem;
        color: #9496a5;
        flex-wrap: wrap;
    }

    .grade-course-price {
        font-weight: 800;
        color: #210057;
    }

        .grade-course-price.has-discount {
            color: #059669;
        }

        .grade-course-price .old-price {
            text-decoration: line-through;
            color: #9496a5;
            font-weight: 500;
            margin-right: 4px;
        }

    .grade-course-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 2px 7px;
        border-radius: 10px;
        font-size: 0.62rem;
        font-weight: 700;
    }

    .grade-course-badge-enrolled {
        background: #059669;
        color: #fff;
    }

    .grade-course-badge-discount {
        background: #fef3c7;
        color: #b45309;
    }

    /* استجابة للشاشات الصغيرة */
    @@media (max-width: 360px) {
        .grade-number

    {
        font-size: 0.82rem;
    }

    .grade-level {
        font-size: 0.62rem;
    }

    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ==========================================
        // بيانات المراحل من الخادم (تُستخدم في الدوال)
        // ==========================================
        const gradesData = @Html.Raw(Json.Serialize(Model.GradesTeachers));

        // دالة مساعدة لجلب اسم المرحلة
        function getGradeDisplayName(gradeNumber) {
            const grade = gradesData.find(g => g.grade === gradeNumber);
            if (grade && grade.gradeLevel) {
                return `الصف ${grade.gradeLevel}`;
            }
            return `الصف ${gradeNumber}`;
        }

        // ==========================================
        // السلايدر التلقائي للأساتذة
        // ==========================================
        const heroSlides = document.querySelectorAll('.hero-slide');
        const heroIndicators = document.querySelectorAll('.hero-slider-indicator');
        let currentHeroSlide = 0;
        let heroSlideInterval;

        function showHeroSlide(index) {
            if (heroSlides.length === 0) return;

            heroSlides.forEach(slide => slide.classList.remove('active'));
            heroIndicators.forEach(indicator => indicator.classList.remove('active'));

            heroSlides[index].classList.add('active');
            if (heroIndicators[index]) {
                heroIndicators[index].classList.add('active');
            }
            currentHeroSlide = index;
        }

        function nextHeroSlide() {
            if (heroSlides.length === 0) return;
            const next = (currentHeroSlide + 1) % heroSlides.length;
            showHeroSlide(next);
        }

        function startHeroSlideshow() {
            if (heroSlides.length > 1) {
                heroSlideInterval = setInterval(nextHeroSlide, 4000);
            }
        }

        function stopHeroSlideshow() {
            clearInterval(heroSlideInterval);
        }

        // النقر على المؤشرات
        heroIndicators.forEach(indicator => {
            indicator.addEventListener('click', function () {
                const index = parseInt(this.dataset.slide);
                showHeroSlide(index);
                stopHeroSlideshow();
                startHeroSlideshow();
            });
        });

        // النقر على السلايد لعرض مواد المعلم
        heroSlides.forEach(slide => {
            slide.addEventListener('click', function () {
                const teacherId = this.dataset.teacherId;
                if (teacherId) {
                    showTeacherCourses(parseInt(teacherId));
                }
            });
        });

        // ==========================================
        // عرض أساتذة المرحلة
        // ==========================================
        function showGradeTeachers(gradeNumber) {
            const grade = gradesData.find(g => g.grade === gradeNumber);

            if (grade && grade.teachers && grade.teachers.length > 0) {
                // ✅ استخدام اسم المرحلة الكامل
                const gradeName = getGradeDisplayName(gradeNumber);

                document.getElementById('modalTitle').innerHTML = `
                    <span>👨‍🏫</span>
                    أساتذة ${gradeName}
                `;

                const teachersList = document.getElementById('teachersList');
                teachersList.innerHTML = grade.teachers.map(teacher => `
                    <div class="teacher-list-item" onclick="showTeacherCourses(${teacher.id})">
                        <div class="teacher-list-avatar">
                            <img src="${teacher.image || '/images/default-avatar.png'}" alt="${escapeHtml(teacher.name || '')}">
                        </div>
                        <div class="teacher-list-info">
                            <div class="teacher-list-name">${escapeHtml(teacher.name || '')}</div>
                            <div class="teacher-list-subject">${escapeHtml(teacher.subject || 'مادة غير محددة')}</div>
                        </div>
                        <i class="fas fa-chevron-left teacher-list-arrow"></i>
                    </div>
                `).join('');

                document.getElementById('teachersModalOverlay').classList.add('show');
                stopHeroSlideshow();
            } else {
                Swal.fire({
                    title: 'لا يوجد أساتذة',
                    text: 'لا يوجد أساتذة مسجلون في هذه المرحلة حالياً',
                    icon: 'info',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#210057'
                });
            }
        }

        function closeTeachersModal() {
            document.getElementById('teachersModalOverlay').classList.remove('show');
            startHeroSlideshow();
        }

        // إغلاق المودال عند النقر خارجه
        document.getElementById('teachersModalOverlay').addEventListener('click', function (e) {
            if (e.target === this) {
                closeTeachersModal();
            }
        });

        // ==========================================
        // عرض مواد المعلم
        // ==========================================
        async function showTeacherCourses(teacherId) {
            closeTeachersModal();

            try {
                const response = await fetch(`/Home/GetTeacherCourses?id=${teacherId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const teacher = await response.json();
                displayTeacherCourses(teacher);
            } catch (error) {
                console.error('Error fetching teacher courses:', error);
                Swal.fire('خطأ', 'حدث خطأ في تحميل بيانات المعلم', 'error');
            }
        }

        // ==========================================
        // عرض بطاقات المواد (مع دعم العروض + الاشتراكات)
        // ==========================================
        function displayTeacherCourses(teacher) {
            const courses = teacher.teacherCourses || teacher.courses || [];
            const mainContainer = document.querySelector('.main-container');

            if (!mainContainer) {
                console.error('Main container not found');
                return;
            }

            const hasCourses = courses && courses.length > 0;

            const coursesHTML = `
                <div style="animation: fadeInUp 0.3s ease;">
                    <button onclick="location.reload()" style="
                        display: inline-flex;
                        align-items: center;
                        gap: 8px;
                        padding: 10px 20px;
                        background: transparent;
                        border: 2px solid #e8eaf0;
                        border-radius: 30px;
                        cursor: pointer;
                        font-size: 0.85rem;
                        font-weight: 600;
                        color: #9496a5;
                        margin-bottom: 20px;
                        transition: all 0.2s;
                        font-family: 'Tajawal', sans-serif;
                    ">
                        <i class="fas fa-arrow-right"></i>
                        العودة للرئيسية
                    </button>

                    <div style="
                        background: #fff;
                        border-radius: 24px;
                        padding: 24px;
                        text-align: center;
                        margin-bottom: 20px;
                        box-shadow: 0 4px 12px rgba(33, 0, 87, 0.08);
                    ">
                        <div style="
                            width: 100px;
                            height: 100px;
                            margin: 0 auto 16px;
                            border-radius: 50%;
                            overflow: hidden;
                            border: 3px solid #210057;
                        ">
                            <img src="${teacher.image || '/images/default-avatar.png'}"
                                 alt="${escapeHtml(teacher.name)}"
                                 style="width: 100%; height: 100%; object-fit: cover;">
                        </div>
                        <h1 style="
                            font-size: 1.3rem;
                            font-weight: 800;
                            margin-bottom: 8px;
                            color: #333;
                        ">${escapeHtml(teacher.name)}</h1>
                        <div style="
                            font-size: 0.85rem;
                            color: #210057;
                            font-weight: 600;
                            margin-bottom: 8px;
                        ">${escapeHtml(teacher.subject || 'مادة غير محددة')}</div>
                        <p style="
                            font-size: 0.85rem;
                            color: #9496a5;
                            line-height: 1.5;
                        ">${escapeHtml(teacher.bio || 'لا يوجد وصف')}</p>
                    </div>

                    <h2 style="
                        font-size: 1.1rem;
                        font-weight: 800;
                        margin-bottom: 16px;
                        padding-right: 12px;
                        border-right: 3px solid #210057;
                        color: #333;
                    ">📘 مواد ${escapeHtml(teacher.name)}</h2>

                    <div style="
                        display: flex;
                        flex-direction: column;
                        gap: 12px;
                    ">
                        ${hasCourses ? courses.map(course => {

                            // حالة الاشتراك
                            const isEnrolled = course.isEnrolled === true;

                            // حساب السعر والعرض
                            const hasDiscount = course.hasActiveDiscount === true;
                            const effectivePrice = Number(course.effectivePrice ?? course.price ?? 0);
                            const originalPrice = Number(course.price ?? 0);
                            const discountPercent = Number(course.discountPercent ?? 0);
                            const discountEndDate = course.discountEndDate
                                ? new Date(course.discountEndDate)
                                : null;

                            const endDateStr = discountEndDate
                                ? discountEndDate.toLocaleDateString('ar-EG', { day: 'numeric', month: 'short' })
                                : '';

                            // كتلة السعر
                            const priceBlock = isEnrolled
                                ? `
                                    <span style="font-size: 0.85rem; font-weight: 700; color: #059669; display:flex; align-items:center; gap:6px;">
                                        <i class="fas fa-check-circle"></i>
                                        تم الشراء
                                    </span>
                                `
                                : (hasDiscount
                                    ? `
                                        <div style="display:flex; flex-direction:column; align-items:flex-start; gap:2px;">
                                            <span style="text-decoration: line-through; color: #9496a5; font-size: 0.8rem;">
                                                ${originalPrice.toLocaleString('ar-EG')} نقطة
                                            </span>
                                            <div style="display:flex; align-items:center; gap:8px;">
                                                <span style="font-size: 1.3rem; font-weight: 900; color: #059669;">
                                                    ${effectivePrice.toLocaleString('ar-EG')} نقطة
                                                </span>
                                                <span style="
                                                    background:#fef3c7; color:#b45309;
                                                    font-size:0.7rem; font-weight:700;
                                                    padding:2px 8px; border-radius:10px;
                                                ">🔥 -${discountPercent}%</span>
                                            </div>
                                        </div>
                                    `
                                    : `
                                        <span style="font-size: 1.2rem; font-weight: 800; color: #210057;">
                                            ${originalPrice.toLocaleString('ar-EG')} نقطة
                                        </span>
                                    `);

                            // العدّاد التنازلي
                            const countdownBlock = (!isEnrolled && hasDiscount && discountEndDate)
                                ? `
                                    <div class="course-countdown"
                                         data-end="${discountEndDate.toISOString()}"
                                         style="
                                            margin-top: 8px;
                                            font-size: 0.72rem;
                                            font-weight: 600;
                                            color: #b45309;
                                            background: #fffbeb;
                                            border: 1px dashed #fcd34d;
                                            border-radius: 8px;
                                            padding: 6px 10px;
                                            display: flex;
                                            align-items: center;
                                            gap: 6px;
                                         ">
                                        <i class="fas fa-clock"></i>
                                        <span class="countdown-text">ينتهي العرض ${endDateStr}</span>
                                    </div>
                                `
                                : '';

                            // الشارة
                            const ribbon = isEnrolled
                                ? `
                                    <div style="
                                        position: absolute;
                                        top: 12px;
                                        left: 12px;
                                        background: linear-gradient(135deg, #059669, #047857);
                                        color: #fff;
                                        padding: 4px 10px;
                                        border-radius: 20px;
                                        font-size: 0.65rem;
                                        font-weight: 800;
                                        box-shadow: 0 2px 6px rgba(4,120,87,0.4);
                                        z-index: 2;
                                        display:flex; align-items:center; gap:4px;
                                    "><i class="fas fa-check"></i> مشترك</div>
                                `
                                : (hasDiscount
                                    ? `
                                        <div style="
                                            position: absolute;
                                            top: 12px;
                                            left: 12px;
                                            background: linear-gradient(135deg, #f59e0b, #d97706);
                                            color: #fff;
                                            padding: 4px 10px;
                                            border-radius: 20px;
                                            font-size: 0.65rem;
                                            font-weight: 800;
                                            box-shadow: 0 2px 6px rgba(217,119,6,0.4);
                                            z-index: 2;
                                        ">🔥 عرض</div>
                                    `
                                    : '');

                            // زر الإجراء
                            const actionButton = isEnrolled
                                ? `
                                    <button onclick="watchCourse(${course.id})"
                                            style="
                                                margin-top: 12px;
                                                background: #059669;
                                                color: #fff;
                                                border: none;
                                                padding: 12px;
                                                border-radius: 12px;
                                                cursor: pointer;
                                                font-weight: 700;
                                                font-size: 0.9rem;
                                                width: 100%;
                                                display: flex;
                                                align-items: center;
                                                justify-content: center;
                                                gap: 8px;
                                                transition: all 0.2s;
                                                font-family: 'Tajawal', sans-serif;
                                            ">
                                        <i class="fas fa-play-circle"></i>
                                        مشاهدة المادة
                                    </button>
                                `
                                : `
                                    <button onclick="enrollInCourse('${teacher.id}', '${course.id}')"
                                            style="
                                                margin-top: 12px;
                                                background: ${hasDiscount ? '#059669' : '#210057'};
                                                color: #fff;
                                                border: none;
                                                padding: 12px;
                                                border-radius: 12px;
                                                cursor: pointer;
                                                font-weight: 700;
                                                font-size: 0.9rem;
                                                width: 100%;
                                                display: flex;
                                                align-items: center;
                                                justify-content: center;
                                                gap: 8px;
                                                transition: all 0.2s;
                                                font-family: 'Tajawal', sans-serif;
                                            ">
                                        ${hasDiscount ? '🔥 اشترك بسعر العرض' : 'تسجيل الآن'}
                                        <i class="fas fa-arrow-left"></i>
                                    </button>
                                `;

                            return `
                                <div style="
                                    position: relative;
                                    background: #fff;
                                    border-radius: 16px;
                                    padding: 20px;
                                    box-shadow: 0 2px 8px rgba(33, 0, 87, 0.08);
                                    transition: all 0.2s;
                                    ${isEnrolled ? 'border: 2px solid #a7f3d0;' : (hasDiscount ? 'border: 2px solid #fde68a;' : '')}
                                ">
                                    ${ribbon}
                                    <div style="font-size: 2rem; margin-bottom: 8px;">📖</div>
                                    <h3 style="
                                        font-size: 1rem;
                                        font-weight: 700;
                                        margin-bottom: 8px;
                                        color: #333;
                                    ">${escapeHtml(course.name)}</h3>
                                    <p style="
                                        font-size: 0.8rem;
                                        color: #9496a5;
                                        margin-bottom: 12px;
                                        line-height: 1.4;
                                    ">${escapeHtml(
                                        course.description
                                            ? (course.description.length > 80
                                                ? course.description.substring(0, 80) + '...'
                                                : course.description)
                                            : 'لا يوجد وصف'
                                    )}</p>

                                    <div style="
                                        margin-bottom: 12px;
                                        padding: 12px;
                                        background: ${isEnrolled ? '#ecfdf5' : (hasDiscount ? '#fffbeb' : '#f8f9fc')};
                                        border-radius: 12px;
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        gap: 8px;
                                    ">
                                        <span style="font-size: 0.8rem; color: #9496a5;">السعر:</span>
                                        ${priceBlock}
                                    </div>

                                    ${countdownBlock}
                                    ${actionButton}
                                </div>
                            `;
                        }).join('') : `
                            <div style="
                                text-align: center;
                                padding: 40px;
                                background: #f8f9fc;
                                border-radius: 16px;
                            ">
                                <div style="font-size: 3rem; margin-bottom: 16px; opacity: 0.5;">📚</div>
                                <p style="color: #333; margin-bottom: 8px;">لا توجد مواد متاحة حالياً</p>
                                <small style="color: #9496a5;">سيتم إضافة مواد جديدة قريباً</small>
                            </div>
                        `}
                    </div>
                </div>
            `;

            mainContainer.innerHTML = coursesHTML;
            window.scrollTo({ top: 0, behavior: 'smooth' });

            setTimeout(initCourseCountdowns, 50);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ==========================================
        // الانتقال إلى مشاهدة المادة
        // ==========================================
        function watchCourse(courseId) {
            window.location.href = `/Course/CourseVideos?courseId=${courseId}`;
        }

        // ==========================================
        // عدّاد تنازلي حيّ
        // ==========================================
        let courseCountdownInterval = null;

        function initCourseCountdowns() {
            if (courseCountdownInterval) {
                clearInterval(courseCountdownInterval);
                courseCountdownInterval = null;
            }

            const countdownEls = document.querySelectorAll('.course-countdown');
            if (countdownEls.length === 0) return;

            const update = () => {
                let anyExpired = false;

                countdownEls.forEach(el => {
                    const endAttr = el.dataset.end;
                    if (!endAttr) return;

                    const end = new Date(endAttr).getTime();
                    const diff = end - Date.now();
                    const textEl = el.querySelector('.countdown-text');
                    if (!textEl) return;

                    if (diff <= 0) {
                        textEl.textContent = 'انتهى العرض';
                        el.style.background = '#fee2e2';
                        el.style.borderColor = '#fecaca';
                        el.style.color = '#dc2626';
                        anyExpired = true;
                        return;
                    }

                    const days = Math.floor(diff / 86400000);
                    const hours = Math.floor(diff / 3600000) % 24;
                    const minutes = Math.floor(diff / 60000) % 60;
                    const seconds = Math.floor(diff / 1000) % 60;

                    let label = 'ينتهي العرض';
                    if (days > 0) label += ` خلال ${days} يوم و${hours} ساعة`;
                    else if (hours > 0) label += ` خلال ${hours} ساعة و${minutes} دقيقة`;
                    else if (minutes > 0) label += ` خلال ${minutes} دقيقة و${seconds} ثانية`;
                    else label += ` خلال ${seconds} ثانية`;

                    textEl.textContent = label;
                });

                if (anyExpired) {
                    clearInterval(courseCountdownInterval);
                    courseCountdownInterval = null;
                    setTimeout(() => {
                        location.reload();
                    }, 3000);
                }
            };

            update();
            courseCountdownInterval = setInterval(update, 1000);
        }

        window.addEventListener('beforeunload', () => {
            if (courseCountdownInterval) clearInterval(courseCountdownInterval);
        });

        // ==========================================
        // التسجيل في مادة
        // ==========================================
        async function enrollInCourse(teacherId, courseId) {
            try {
                Swal.fire({
                    title: 'جاري التحقق...',
                    text: 'يتم التحقق من الرصيد وإتمام التسجيل',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const response = await fetch(`/Course/Enroll?courseId=${courseId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                    }
                });

                const data = await response.json();
                Swal.close();

                if (data.success) {
                    Swal.fire({
                        title: '🎉 تم التسجيل بنجاح!',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'عرض موادي',
                        confirmButtonColor: '#210057',
                        showCancelButton: true,
                        cancelButtonText: 'البقاء هنا',
                        cancelButtonColor: '#9496a5'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/MyCourses/Index';
                        } else {
                            location.reload();
                        }
                    });
                } else {
                    Swal.fire({
                        title: 'خطأ',
                        text: data.message,
                        icon: 'error',
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#210057'
                    });
                }
            } catch (error) {
                console.error('Error enrolling in course:', error);
                Swal.close();
                Swal.fire({
                    title: 'خطأ في الاتصال',
                    text: 'حدث خطأ في الاتصال بالخادم',
                    icon: 'error',
                    confirmButtonText: 'حسناً',
                    confirmButtonColor: '#210057'
                });
            }
        }

        // ==========================================
        // عرض مواد المرحلة
        // ==========================================
        async function showGradeCourses(gradeNumber) {
            const overlay = document.getElementById('coursesModalOverlay');
            const title = document.getElementById('coursesModalTitle');
            const list = document.getElementById('coursesList');

            // ✅ استخدام اسم المرحلة الكامل
            const gradeName = getGradeDisplayName(gradeNumber);

            title.innerHTML = `<span>📚</span> مواد ${gradeName}`;
            list.innerHTML = `
                <div style="text-align:center; padding:40px; color:#9496a5;">
                    <div class="spinner-border text-primary" role="status" style="width:1.5rem; height:1.5rem;"></div>
                    <p style="margin-top:10px; font-size:0.85rem;">جارٍ التحميل...</p>
                </div>`;

            overlay.classList.add('show');
            stopHeroSlideshow();

            try {
                const response = await fetch(`/Home/GetGradeCourses?grade=${gradeNumber}`);
                const data = await response.json();

                if (!data.success) {
                    list.innerHTML = `
                        <div style="text-align:center; padding:40px; color:#dc2626;">
                            <i class="fas fa-exclamation-circle" style="font-size:2rem; margin-bottom:8px; display:block;"></i>
                            <p>${escapeHtml(data.message || 'تعذر تحميل المواد')}</p>
                        </div>`;
                    return;
                }

                if (!data.courses || data.courses.length === 0) {
                    list.innerHTML = `
                        <div style="text-align:center; padding:40px; color:#9496a5;">
                            <div style="font-size:3rem; margin-bottom:12px; opacity:0.5;">📚</div>
                            <p style="color:#333; margin-bottom:6px;">لا توجد مواد لهذه المرحلة</p>
                            <small style="display:block; margin-bottom:16px;">سيتم إضافة مواد جديدة قريباً</small>
                            <a href="/Course/Index"
                               style="display:inline-flex; align-items:center; gap:6px;
                                      padding:10px 20px; background:#210057; color:#fff;
                                      border-radius:10px; text-decoration:none;
                                      font-size:0.8rem; font-weight:700;">
                                <i class="fas fa-book-open"></i>
                                تصفح جميع المواد
                            </a>
                        </div>`;
                    return;
                }

                const coursesHtml = data.courses.map(course => {
                    const isEnrolled = course.isEnrolled === true;
                    const hasDiscount = course.hasActiveDiscount === true;
                    const effectivePrice = Number(course.effectivePrice ?? course.price ?? 0);
                    const originalPrice = Number(course.price ?? 0);
                    const discountPercent = Number(course.discountPercent ?? 0);

                    const priceHtml = isEnrolled
                        ? `<span class="grade-course-badge grade-course-badge-enrolled"><i class="fas fa-check"></i> مشترك</span>`
                        : (hasDiscount
                            ? `<span class="grade-course-price has-discount">
                                   <span class="old-price">${originalPrice.toLocaleString('ar-EG')}</span>
                                   ${effectivePrice.toLocaleString('ar-EG')} نقطة
                               </span>
                               <span class="grade-course-badge grade-course-badge-discount">🔥 -${discountPercent}%</span>`
                            : `<span class="grade-course-price">${originalPrice.toLocaleString('ar-EG')} نقطة</span>`);

                    return `
                        <div class="grade-course-item ${isEnrolled ? 'is-enrolled' : ''}"
                             onclick="goToCourseDetails(${course.id})">
                            <div class="grade-course-icon">
                                <i class="fas ${isEnrolled ? 'fa-check-circle' : 'fa-book'}"></i>
                            </div>
                            <div class="grade-course-info">
                                <div class="grade-course-name">${escapeHtml(course.name)}</div>
                                <div class="grade-course-meta">
                                    ${priceHtml}
                                </div>
                            </div>
                            <i class="fas fa-chevron-left" style="color:#9496a5; font-size:0.8rem;"></i>
                        </div>
                    `;
                }).join('');

                // زر "عرض جميع المواد"
                const viewAllBtn = `
                    <a href="/Course/Index"
                       style="
                           display: flex;
                           align-items: center;
                           justify-content: center;
                           gap: 8px;
                           margin-top: 12px;
                           padding: 14px;
                           border: 2px dashed #210057;
                           border-radius: 14px;
                           background: #f0ebf8;
                           color: #210057;
                           text-decoration: none;
                           font-size: 0.85rem;
                           font-weight: 800;
                           font-family: 'Tajawal', sans-serif;
                           transition: all 0.2s ease;
                       "
                       onmouseover="this.style.background='#210057'; this.style.color='#fff'; this.style.borderStyle='solid';"
                       onmouseout="this.style.background='#f0ebf8'; this.style.color='#210057'; this.style.borderStyle='dashed';">
                        <i class="fas fa-th-large"></i>
                        <span>عرض جميع المواد في المنصة</span>
                        <i class="fas fa-arrow-left"></i>
                    </a>
                `;

                list.innerHTML = coursesHtml + viewAllBtn;

            } catch (error) {
                console.error('Error loading grade courses:', error);
                list.innerHTML = `
                    <div style="text-align:center; padding:40px; color:#dc2626;">
                        <i class="fas fa-wifi" style="font-size:2rem; margin-bottom:8px; display:block;"></i>
                        <p>تعذر الاتصال بالخادم</p>
                    </div>`;
            }
        }

        function closeCoursesModal() {
            document.getElementById('coursesModalOverlay').classList.remove('show');
            startHeroSlideshow();
        }

        function goToCourseDetails(courseId) {
            closeCoursesModal();
            setTimeout(() => {
                window.location.href = `/Course/Details/${courseId}`;
            }, 200);
        }

        // إغلاق المودال عند النقر خارجه
        document.getElementById('coursesModalOverlay')?.addEventListener('click', function (e) {
            if (e.target === this) {
                closeCoursesModal();
            }
        });

        // ==========================================
        // تهيئة الصفحة
        // ==========================================
        document.addEventListener('DOMContentLoaded', function () {
            startHeroSlideshow();

            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    stopHeroSlideshow();
                } else {
                    startHeroSlideshow();
                }
            });
        });
    </script>
}
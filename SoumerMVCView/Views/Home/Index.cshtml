@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="home-page">
    <!-- Hero Section -->
    <div class="hero-section-enhanced">
        <div class="hero-content">
            <h1 class="hero-title">📚 منصة سومر التعليمية</h1>
            <p class="hero-subtitle">تعلم مع أفضل الأساتذة</p>
            <div class="hero-buttons">
                <button class="hero-btn-primary" onclick="document.getElementById('gradesSection').scrollIntoView({behavior: 'smooth'})">
                    استعرض الأساتذة
                    <span>↓</span>
                </button>
            </div>
        </div>
        <div class="hero-decoration"></div>
    </div>

    <!-- Featured Teachers Section -->
    <div class="featured-section-enhanced">
        <div class="section-header">
            <h2 class="section-title-enhanced">
                <span class="title-icon">🌟</span>
                أساتذة مميزون
            </h2>
        </div>
        <div class="horizontal-scroll-enhanced" id="featuredTeachers">
            @if (Model.FeaturedTeachers != null && Model.FeaturedTeachers.Any())
            {
                @foreach (var teacher in Model.FeaturedTeachers)
                {
                    <div class="teacher-card-enhanced" data-teacher-id="@teacher.Id">
                        <div class="teacher-card-image">
                            <img src="@(string.IsNullOrEmpty(teacher.Image) ? "/images/default-avatar.png" : teacher.Image)" alt="@teacher.Name">
                        </div>
                        <div class="teacher-card-info">
                            <h3 class="teacher-name-enhanced">@teacher.Name</h3>
                            <div class="teacher-subject-enhanced">@teacher.Subject</div>
                            <p class="teacher-bio-enhanced">@(string.IsNullOrEmpty(teacher.Bio) ? "لا يوجد وصف" : teacher.Bio)</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-enhanced">لا يوجد أساتذة مميزون حالياً</div>
            }
        </div>
    </div>

    <!-- Grades Teachers Section -->
    <div id="gradesSection" class="grades-section-enhanced">
        <div class="section-header">
            <h2 class="section-title-enhanced">
                <span class="title-icon">📖</span>
                الأساتذة حسب الصفوف
            </h2>
        </div>

        <div id="gradesContainer">
            @if (Model.GradesTeachers != null && Model.GradesTeachers.Any())
            {
                foreach (var grade in Model.GradesTeachers)
                {
                    <div class="grade-section-enhanced">
                        <div class="grade-header-enhanced">
                            <div class="grade-info">
                                <span class="grade-number-enhanced">الصف @grade.Grade</span>
                                <span class="grade-desc-enhanced">@grade.GradeLevel</span>
                            </div>
                            <span class="grade-badge">
                                @grade.Teachers.Count أستاذ
                            </span>
                        </div>
                        <div class="horizontal-scroll-enhanced">
                            @if (grade.Teachers != null && grade.Teachers.Any())
                            {
                                @foreach (var teacher in grade.Teachers)
                                {
                                    <div class="teacher-card-enhanced" data-teacher-id="@teacher.Id">
                                        <div class="teacher-card-image">
                                            <img src="@(string.IsNullOrEmpty(teacher.Image) ? "/images/default-avatar.png" : teacher.Image)" alt="@teacher.Name">
                                        </div>
                                        <div class="teacher-card-info">
                                            <h3 class="teacher-name-enhanced">@teacher.Name</h3>
                                            <div class="teacher-subject-enhanced">@teacher.Subject</div>
                                            <p class="teacher-bio-enhanced">@(string.IsNullOrEmpty(teacher.Bio) ? "لا يوجد وصف" : teacher.Bio)</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state-enhanced">لا يوجد أساتذة في هذا الصف حالياً</div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state-enhanced">لا توجد بيانات للصفوف حالياً</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Teacher Card Handlers
        function attachTeacherCardEvents() {
            document.querySelectorAll('.teacher-card-enhanced').forEach(card => {
                card.removeEventListener('click', handleTeacherClick);
                card.addEventListener('click', handleTeacherClick);
            });
        }

        async function handleTeacherClick(e) {
            e.stopPropagation();
            const teacherId = this.getAttribute('data-teacher-id');

            if (!teacherId) {
                console.warn('No teacher ID found');
                return;
            }

            try {
                const response = await fetch(`/Home/GetTeacherCourses?id=${teacherId}`);
                if (!response.ok) throw new Error('Network response was not ok');
                const teacher = await response.json();
                showTeacherCourses(teacher);
            } catch (error) {
                console.error('Error fetching teacher courses:', error);
                Swal.fire('خطأ', 'حدث خطأ في تحميل بيانات المعلم', 'error');
            }
        }

        function showTeacherCourses(teacher) {
            const courses = teacher.teacherCourses || teacher.courses || [];
            const mainContainer = document.querySelector('.main-container');

            if (!mainContainer) return;

            const coursesHTML = `
                <div class="courses-page-enhanced">
                    <button class="back-home-btn-enhanced" onclick="location.reload()">
                        ← العودة للرئيسية
                    </button>
                    <div class="teacher-profile-card">
                        <div class="teacher-profile-image">
                            <img src="${teacher.image || '/images/default-avatar.png'}" alt="${teacher.name}">
                        </div>
                        <div class="teacher-profile-info">
                            <h1 class="teacher-profile-name">${teacher.name}</h1>
                            <div class="teacher-profile-subject">${teacher.subject || 'مادة غير محددة'}</div>
                            <p class="teacher-profile-bio">${teacher.bio || ''}</p>
                        </div>
                    </div>
                    <div class="courses-grid">
                        <h2 class="courses-grid-title">📘 كورسات ${teacher.name}</h2>
                        <div class="courses-grid-container">
                            ${courses.length > 0 ? courses.map(course => `
                                <div class="course-card-enhanced">
                                    <div class="course-card-icon">📖</div>
                                    <h3 class="course-card-title">${course.name || course}</h3>
                                    <p class="course-card-subject">${teacher.subject}</p>
                                    <button class="enroll-btn-enhanced" onclick="enrollInCourse('${teacher.id}', '${course.id || course}')">
                                        تسجيل الآن
                                        <span>→</span>
                                    </button>
                                </div>
                            `).join('') : '<div class="empty-state-enhanced">لا توجد كورسات متاحة حالياً</div>'}
                        </div>
                    </div>
                </div>
            `;

            mainContainer.innerHTML = coursesHTML;
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function enrollInCourse(teacherId, courseId) {
            Swal.fire({
                title: 'تم الإضافة!',
                text: '✨ تم إضافة الكورس إلى قائمة التسجيل الخاصة بك',
                icon: 'success',
                confirmButtonText: 'حسناً',
                confirmButtonColor: '#2563eb'
            });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            attachTeacherCardEvents();
        });
    </script>
}
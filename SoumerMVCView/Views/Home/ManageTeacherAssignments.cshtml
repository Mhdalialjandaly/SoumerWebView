@model ManageTeacherAssignmentsViewModel

@{
    ViewData["Title"] = "إدارة توزيع الأساتذة على الصفوف";
}

<div class="container-fluid mt-4" dir="rtl">
    <!-- Header Section -->
    <div class="assignments-header">
        <div class="header-content">
            <div>
                <h1 class="assignments-title">👨‍🏫 إدارة توزيع الأساتذة</h1>
                <p class="assignments-subtitle">توزيع الأساتذة على الصفوف الدراسية وتحديد الأولويات</p>
            </div>
            <div class="stats-summary">
                <div class="stat-badge">
                    <span class="stat-number">@Model.GradesAssignments.Sum(g => g.AssignedTeachers.Count)</span>
                    <span class="stat-label">أستاذ موزع</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-number">@Model.GradesAssignments.Count</span>
                    <span class="stat-label">صف دراسي</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Teacher Form - Enhanced -->
    <div class="add-teacher-card">
        <div class="card-header-custom">
            <div class="header-icon">➕</div>
            <h5 class="header-title">إضافة أستاذ إلى صف</h5>
            <span class="header-badge">توزيع جديد</span>
        </div>
        <div class="card-body-custom">
            <form id="assignTeacherForm" class="assign-form">
                <div class="form-row">
                    <div class="form-group-enhanced">
                        <label class="form-label-enhanced">
                            <span class="label-icon">👨‍🏫</span>
                            اختر الأستاذ
                        </label>
                        <select id="teacherId" name="teacherId" class="form-select-enhanced" required>
                            <option value="">-- اختر الأستاذ --</option>
                            @foreach (var teacher in Model.AssignForm.AvailableTeachers)
                            {
                                <option value="@teacher.Id" data-subject="@teacher.Subject">
                                    @teacher.Name - @teacher.Subject
                                </option>
                            }
                        </select>
                        <div id="teacherPreview" class="teacher-preview" style="display: none;">
                            <img id="teacherPreviewImage" src="" alt="" style="width: 40px; height: 40px; border-radius: 50%;">
                            <div>
                                <div id="teacherPreviewName"></div>
                                <div id="teacherPreviewSubject" class="text-muted small"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group-enhanced">
                        <label class="form-label-enhanced">
                            <span class="label-icon">📚</span>
                            اختر الصف
                        </label>
                        <select id="grade" name="grade" class="form-select-enhanced" required>
                            <option value="">-- اختر الصف --</option>
                            @foreach (var grade in Model.AssignForm.AvailableGrades)
                            {
                                <option value="@grade">الصف @grade</option>
                            }
                        </select>
                        <div id="gradeInfo" class="grade-info" style="display: none;">
                            <span class="info-badge"></span>
                        </div>
                    </div>

                    <div class="form-group-enhanced">
                        <label class="form-label-enhanced">
                            <span class="label-icon">⭐</span>
                            الأولوية
                        </label>
                        <input type="number" id="priority" name="priority" class="form-control-enhanced"
                               min="1" required placeholder="مثال: 1, 2, 3...">
                        <small class="form-hint">الأولوية 1 هي الأعلى ترتيباً</small>
                    </div>

                    <div class="form-group-enhanced form-actions">
                        <button type="submit" class="btn-submit-enhanced">
                            <span>➕</span> إضافة الأستاذ
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Grades Assignments Accordion - Enhanced -->
    <div class="grades-accordion-wrapper">
        <div class="accordion-header-wrapper">
            <div class="header-icon">📋</div>
            <h3>توزيع الأساتذة حسب الصفوف</h3>
        </div>

        <div class="accordion-enhanced" id="gradesAccordion">
            @foreach (var gradeItem in Model.GradesAssignments)
            {
                var assignedCount = gradeItem.AssignedTeachers.Count;
                var requiredCount = gradeItem.RequiredTeachersCount;
                var isComplete = assignedCount >= requiredCount;
                var remaining = requiredCount - assignedCount;

                <div class="accordion-item-enhanced">
                    <div class="accordion-header-enhanced" data-bs-toggle="collapse"
                         data-bs-target="#collapse@(gradeItem.Grade)"
                         aria-expanded="@(gradeItem.Grade == 1 ? "true" : "false")">
                        <div class="accordion-title">
                            <div class="grade-icon">📖</div>
                            <div class="grade-info-enhanced">
                                <span class="grade-number-enhanced">الصف @gradeItem.Grade</span>
                                <span class="grade-level-enhanced">@gradeItem.GradeLevel</span>
                            </div>
                        </div>
                        <div class="accordion-stats">
                            <div class="teacher-count-badge @(isComplete ? "complete" : "incomplete")">
                                <span class="count">@assignedCount</span>
                                <span class="total">/@requiredCount</span>
                                <span class="label">أستاذ</span>
                            </div>
                            @if (!isComplete && remaining > 0)
                            {
                                <div class="remaining-badge">
                                    ⚠️ بحاجة إلى @remaining أستاذ
                                </div>
                            }
                            <div class="accordion-arrow">▼</div>
                        </div>
                    </div>

                    <div id="collapse@(gradeItem.Grade)"
                         class="accordion-collapse-enhanced collapse @(gradeItem.Grade == 1 ? "show" : "")">
                        <div class="accordion-body-enhanced">
                            @if (gradeItem.AssignedTeachers.Any())
                            {
                                <div class="teachers-table-wrapper">
                                    <table class="teachers-table-enhanced">
                                        <thead>
                                            <tr>
                                                <th style="width: 80px">الأولوية</th>
                                                <th style="width: 80px">الصورة</th>
                                                <th>اسم الأستاذ</th>
                                                <th>المادة</th>
                                                <th style="width: 180px">تعديل الأولوية</th>
                                                <th style="width: 100px">الإجراءات</th>
                                            </tr>
                                        </thead>
                                        <tbody id="teachersList_@gradeItem.Grade">
                                            @foreach (var teacher in gradeItem.AssignedTeachers.OrderBy(t => t.Priority))
                                            {
                                                <tr id="teacher_@gradeItem.Grade@teacher.TeacherId" class="teacher-row">
                                                    <td class="priority-cell">
                                                        <span class="priority-number">@teacher.Priority</span>
                                                    </td>
                                                    <td class="avatar-cell">
                                                        @if (!string.IsNullOrEmpty(teacher.Image))
                                                        {
                                                            <img src="@teacher.Image" alt="@teacher.TeacherName"
                                                                 class="teacher-avatar-sm">
                                                        }
                                                        else
                                                        {
                                                            <div class="teacher-avatar-placeholder">
                                                                <span>👤</span>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="teacher-name-cell">
                                                        <div class="teacher-name-enhanced">@teacher.TeacherName</div>
                                                    </td>
                                                    <td>
                                                        <span class="subject-badge">@teacher.Subject</span>
                                                    </td>
                                                    <td>
                                                        <div class="priority-control">
                                                            <input type="number"
                                                                   class="priority-input-enhanced"
                                                                   value="@teacher.Priority"
                                                                   data-grade="@gradeItem.Grade"
                                                                   data-teacher="@teacher.TeacherId"
                                                                   min="1"
                                                                   max="@gradeItem.AssignedTeachers.Count"
                                                                   step="1">
                                                            <button class="btn-update-priority"
                                                                    data-grade="@gradeItem.Grade"
                                                                    data-teacher="@teacher.TeacherId"
                                                                    title="تحديث الأولوية">
                                                                <span>💾</span>
                                                            </button>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <button class="btn-remove-teacher"
                                                                data-grade="@gradeItem.Grade"
                                                                data-teacher="@teacher.TeacherId"
                                                                data-name="@teacher.TeacherName"
                                                                title="حذف الأستاذ">
                                                            <span>🗑️</span>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="empty-teachers-state">
                                    <div class="empty-icon">👨‍🏫</div>
                                    <p>لا يوجد أساتذة في هذا الصف</p>
                                    <small>قم بإضافة أساتذة باستخدام النموذج أعلاه</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            // Preview teacher selection
            $('#teacherId').change(function() {
                const selectedOption = $(this).find('option:selected');
                if (selectedOption.val()) {
                    const teacherName = selectedOption.text().split(' - ')[0];
                    const teacherSubject = selectedOption.data('subject');
                    $('#teacherPreviewName').text(teacherName);
                    $('#teacherPreviewSubject').text(teacherSubject);
                    $('#teacherPreview').show();
                } else {
                    $('#teacherPreview').hide();
                }
            });

            // Grade selection handler
            $('#grade').change(function() {
                const grade = $(this).val();
                if (grade) {
                    // Show grade info
                    $('#gradeInfo').show();
                    $('#gradeInfo .info-badge').text(`الصف ${grade}`);

                    // Get next priority
                    $.ajax({
                        url: '/Home/GetNextPriority',
                        type: 'POST',
                        data: { grade: grade },
                        success: function(response) {
                            if (response.success) {
                                $('#priority').val(response.priority);
                            }
                        }
                    });

                    // Get available teachers for this grade
                    $.ajax({
                        url: '/Home/GetAvailableTeachersForGrade',
                        type: 'POST',
                        data: { grade: grade },
                        success: function(response) {
                            if (response.success && response.teachers) {
                                const teacherSelect = $('#teacherId');
                                const currentVal = teacherSelect.val();
                                teacherSelect.empty();
                                teacherSelect.append('<option value="">-- اختر الأستاذ --</option>');

                                response.teachers.forEach(teacher => {
                                    teacherSelect.append(`<option value="${teacher.id}" data-subject="${teacher.subject}">${teacher.name} - ${teacher.subject}</option>`);
                                });

                                if (currentVal && teacherSelect.find(`option[value="${currentVal}"]`).length) {
                                    teacherSelect.val(currentVal);
                                }
                            }
                        }
                    });
                } else {
                    $('#gradeInfo').hide();
                }
            });

            // Submit assign teacher form
            $('#assignTeacherForm').submit(function(e) {
                e.preventDefault();

                const teacherId = $('#teacherId').val();
                const grade = $('#grade').val();
                const priority = $('#priority').val();

                if (!teacherId || !grade || !priority) {
                    Swal.fire({
                        title: 'خطأ',
                        text: 'يرجى ملء جميع الحقول',
                        icon: 'error',
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#ef4444'
                    });
                    return;
                }

                const teacherName = $('#teacherId option:selected').text().split(' - ')[0];

                Swal.fire({
                    title: 'تأكيد الإضافة',
                    html: `هل أنت متأكد من إضافة الأستاذ <strong>${teacherName}</strong> إلى <strong>الصف ${grade}</strong>؟<br>الأولوية: <strong>${priority}</strong>`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، أضف',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#64748b'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Home/AssignTeacherToGrade',
                            type: 'POST',
                            data: {
                                teacherId: teacherId,
                                grade: grade,
                                priority: priority
                            },
                            beforeSend: function() {
                                Swal.fire({
                                    title: 'جاري الإضافة...',
                                    allowOutsideClick: false,
                                    didOpen: () => {
                                        Swal.showLoading();
                                    }
                                });
                            },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: 'تم الإضافة',
                                        text: 'تم إضافة الأستاذ بنجاح',
                                        icon: 'success',
                                        confirmButtonText: 'حسناً',
                                        confirmButtonColor: '#10b981'
                                    }).then(() => location.reload());
                                } else {
                                    Swal.fire({
                                        title: 'خطأ',
                                        text: response.message || 'حدث خطأ أثناء إضافة الأستاذ',
                                        icon: 'error',
                                        confirmButtonText: 'حسناً',
                                        confirmButtonColor: '#ef4444'
                                    });
                                }
                            },
                            error: function() {
                                Swal.fire({
                                    title: 'خطأ',
                                    text: 'حدث خطأ في الاتصال بالخادم',
                                    icon: 'error',
                                    confirmButtonText: 'حسناً',
                                    confirmButtonColor: '#ef4444'
                                });
                            }
                        });
                    }
                });
            });

            // Update priority
            $(document).on('click', '.btn-update-priority', function() {
                const button = $(this);
                const grade = button.data('grade');
                const teacherId = button.data('teacher');
                const priorityInput = button.closest('tr').find('.priority-input-enhanced');
                const newPriority = priorityInput.val();

                if (!newPriority || newPriority < 1) {
                    Swal.fire('خطأ', 'يرجى إدخال أولوية صحيحة', 'error');
                    return;
                }

                $.ajax({
                    url: '/Home/UpdateTeacherPriority',
                    type: 'POST',
                    data: {
                        teacherId: teacherId,
                        grade: grade,
                        newPriority: newPriority
                    },
                    beforeSend: function() {
                        button.html('<span>⏳</span>');
                        button.prop('disabled', true);
                    },
                    success: function(response) {
                        if (response.success) {
                            Swal.fire({
                                title: 'تم التحديث',
                                text: 'تم تحديث الأولوية بنجاح',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('خطأ', 'حدث خطأ أثناء تحديث الأولوية', 'error');
                            button.html('<span>💾</span>');
                            button.prop('disabled', false);
                        }
                    },
                    error: function() {
                        Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
                        button.html('<span>💾</span>');
                        button.prop('disabled', false);
                    }
                });
            });

            $('.accordion-header-enhanced').click(function() {
                const targetId = $(this).data('accordion-target');
                const targetElement = $(targetId);
                const isOpen = targetElement.hasClass('show');

                if (isOpen) {
                    targetElement.removeClass('show');
                    $(this).removeClass('active');
                } else {
                    targetElement.addClass('show');
                    $(this).addClass('active');
                }
            });

            // Remove teacher from grade
            $(document).on('click', '.btn-remove-teacher', function() {
                const button = $(this);
                const grade = button.data('grade');
                const teacherId = button.data('teacher');
                const teacherName = button.data('name');

                Swal.fire({
                    title: 'تأكيد الحذف',
                    html: `هل أنت متأكد من حذف الأستاذ <strong>${teacherName}</strong> من <strong>الصف ${grade}</strong>؟`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'نعم، احذف',
                    cancelButtonText: 'إلغاء',
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Home/RemoveTeacherFromGrade',
                            type: 'POST',
                            data: {
                                teacherId: teacherId,
                                grade: grade
                            },
                            beforeSend: function() {
                                Swal.fire({
                                    title: 'جاري الحذف...',
                                    allowOutsideClick: false,
                                    didOpen: () => {
                                        Swal.showLoading();
                                    }
                                });
                            },
                            success: function(response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: 'تم الحذف',
                                        text: 'تم حذف الأستاذ بنجاح',
                                        icon: 'success',
                                        confirmButtonText: 'حسناً',
                                        confirmButtonColor: '#10b981'
                                    }).then(() => location.reload());
                                } else {
                                    Swal.fire('خطأ', 'حدث خطأ أثناء حذف الأستاذ', 'error');
                                }
                            },
                            error: function() {
                                Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
                            }
                        });
                    }
                });
            });

            // Enter key support for priority input
            $(document).on('keypress', '.priority-input-enhanced', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $(this).closest('tr').find('.btn-update-priority').click();
                }
            });
        });
    </script>
}
@model MyCoursesViewModel
@{
    ViewData["Title"] = "موادي";
}

<div class="my-courses-page">
    <!-- ترويسة الصفحة -->
    <div class="my-courses-header">
        <h1 class="my-courses-title">
            <span class="title-icon">📚</span>
            موادي
        </h1>
        <span class="my-courses-badge">
            @Model.TotalEnrolled مادة
        </span>
    </div>

    <!-- بطاقات الإحصائيات -->
    <div class="stats-container">
        <div class="stats-card">
            <div class="stats-icon">📖</div>
            <div class="stats-number">@Model.TotalEnrolled</div>
            <div class="stats-label">مادة مسجل</div>
        </div>
        <div class="stats-card">
            <div class="stats-icon">💎</div>
            <div class="stats-number">@Model.TotalSpent.ToString("N0")</div>
            <div class="stats-label">نقطة منفقة</div>
        </div>
        <div class="stats-card">
            <div class="stats-icon">🎬</div>
            <div class="stats-number">@Model.TotalVideos</div>
            <div class="stats-label">فيديو</div>
        </div>
    </div>

    <!-- قسم المواد المسجل فيها -->
    <div class="enrolled-courses-section">
        <div class="section-header">
            <h2 class="section-title">
                <span>📖</span>
                المواد المسجل فيها
            </h2>
            <span class="section-count">
                @(Model.EnrolledCourses?.Count ?? 0)
            </span>
        </div>

        @if (Model.EnrolledCourses != null && Model.EnrolledCourses.Any())
        {
            <div class="course-list">
                @foreach (var enrollment in Model.EnrolledCourses)
                {
                    var videos = Model.CourseVideos != null && Model.CourseVideos.ContainsKey(enrollment.CourseId)
                    ? Model.CourseVideos[enrollment.CourseId]
                    : new List<CourseVideoDto>();

                    <div class="course-item-wrapper">
                        <!-- استخدام details/summary بدلاً من JavaScript -->
                        <details class="course-details">
                            <summary class="course-item">
                                <div class="course-icon">📘</div>
                                <div class="course-info">
                                    <div class="course-name">@enrollment.Course.Name</div>
                                    <div class="course-date">
                                        <i class="fa-regular fa-calendar"></i>
                                        تاريخ التسجيل: @enrollment.CreatedAt.ToString("yyyy/MM/dd")
                                    </div>
                                </div>
                                @if (videos.Any())
                                {
                                    <span class="course-videos-count">
                                        <i class="fa-solid fa-play"></i>
                                        @videos.Count(v => v.IsPublished) فيديو
                                    </span>
                                }
                                <span class="course-price-badge">
                                    @enrollment.Course.Price.ToString("N0") نقطة
                                </span>
                                <a href="/Course/Details/@enrollment.CourseId" class="course-details-btn" onclick="event.stopPropagation();">
                                    <i class="fa-solid fa-eye"></i>
                                    التفاصيل
                                </a>
                            </summary>

                            @if (videos.Any(v => v.IsPublished))
                            {
                                <div class="videos-dropdown-content">
                                    <div class="videos-header">
                                        <span>🎬 فيديوهات المادة</span>
                                        <span>@videos.Count(v => v.IsPublished) فيديو</span>
                                    </div>
                                    <div class="videos-list">
                                        @foreach (var video in videos.Where(v => v.IsPublished))
                                        {
                                            <div class="video-item">
                                                <div class="video-thumbnail">
                                                    <i class="fa-solid fa-play"></i>
                                                    <div class="video-play-overlay">
                                                        <i class="fa-solid fa-play"></i>
                                                    </div>
                                                </div>
                                                <div class="video-info">
                                                    <div class="video-title">@video.Title</div>
                                                    <div class="video-duration">
                                                        <i class="fa-regular fa-clock"></i>
                                                        @(video.Duration > 0 ? $"{video.Duration} دقيقة" : "المدة غير محددة")
                                                    </div>
                                                </div>

                                                <!-- زر فتح المودال باستخدام Bootstrap Modal -->
                                                <button class="video-watch-btn" data-bs-toggle="modal" data-bs-target="#videoModal-@video.Id">
                                                    <i class="fa-solid fa-play"></i>
                                                    معاينة
                                                </button>

                                                <a href="@Url.Action("WatchVideo", "MyCourses", new { videoId = video.Id })"
                                                   class="btn-fullscreen-watch">
                                                    <i class="fa-solid fa-expand"></i>
                                                    مشاهدة
                                                </a>
                                            </div>

                                            <!-- مودال معاينة الفيديو لكل فيديو -->
                                            <div class="modal fade" id="videoModal-@video.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                                    <div class="modal-content" style="border-radius: 20px; overflow: hidden;">
                                                        <div class="modal-header" style="background: #210057; color: #fff; border: none;">
                                                            <h5 class="modal-title">
                                                                <i class="fa-solid fa-play-circle me-2"></i>
                                                                @video.Title
                                                            </h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body p-0">
                                                            <div class="ratio ratio-16x9">
                                                                @if (!string.IsNullOrEmpty(video.EmbedUrl))
                                                                {
                                                                    <iframe src="@video.EmbedUrl"
                                                                            title="@video.Title"
                                                                            frameborder="0"
                                                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                                            allowfullscreen>
                                                                    </iframe>
                                                                }
                                                                else
                                                                {
                                                                    <div style="background: #000; color: #fff; display: flex; align-items: center; justify-content: center; flex-direction: column;">
                                                                        <i class="fa-solid fa-video-slash" style="font-size: 3rem; margin-bottom: 16px;"></i>
                                                                        <p>رابط الفيديو غير متوفر</p>
                                                                    </div>
                                                                }
                                                            </div>
                                                            <div style="padding: 16px 20px;">
                                                                @if (!string.IsNullOrEmpty(video.Description))
                                                                {
                                                                    <p style="color: #9496a5; margin-bottom: 12px;">@video.Description</p>
                                                                }
                                                                <a href="@Url.Action("WatchVideo", "MyCourses", new { videoId = video.Id })"
                                                                   class="btn-fullscreen-watch">
                                                                    <i class="fa-solid fa-expand"></i>
                                                                    مشاهدة في صفحة كاملة
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </details>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-courses">
                <div class="empty-courses-icon">📭</div>
                <h3 class="empty-courses-title">لم تسجل في أي مادة بعد</h3>
                <p class="empty-courses-text">استعرض المواد المتاحة وابدأ رحلتك التعليمية</p>
                <a href="/Course/Index" class="browse-courses-btn">
                    <i class="fa-solid fa-book-open"></i>
                    استعرض المواد
                </a>
            </div>
        }
    </div>
</div>

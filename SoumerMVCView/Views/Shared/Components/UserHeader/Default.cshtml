@model UserHeaderViewModel

@if (!string.IsNullOrEmpty(Model.UserId))
{
    <div class="user-info">
        <button class="icon-btn" id="userMenuBtn" aria-label="قائمة المستخدم" type="button">
            <span class="user-avatar">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.DisplayName"
                         onerror="this.onerror=null; this.parentElement.innerHTML='<span class=&quot;avatar-initial&quot;>@Model.Initial</span>';" />
                }
                else
                {
                    <span class="avatar-initial">@Model.Initial</span>
                }
            </span>
            <span class="user-name">@Model.DisplayName</span>
            <span class="dropdown-arrow" id="dropdownArrow">
                <i class="fa-solid fa-chevron-down"></i>
            </span>
        </button>
        <div id="userDropdown" class="dropdown-menu">
            <!-- معلومات المستخدم -->
            <div class="dropdown-user-info">
                <div class="dropdown-user-avatar">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.DisplayName"
                             onerror="this.onerror=null; this.parentElement.innerHTML='<span class=&quot;avatar-initial&quot;>@Model.Initial</span>';" />
                    }
                    else
                    {
                        <span class="avatar-initial">@Model.Initial</span>
                    }
                </div>
                <div class="dropdown-user-details">
                    <strong>@Model.DisplayName</strong>
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <small>@Model.Email</small>
                    }
                </div>
            </div>
            <div class="dropdown-divider"></div>
            <a asp-controller="Account" asp-action="Profile" class="dropdown-item">
                <i class="fa-regular fa-id-card"></i>
                <span>ملفي الشخصي</span>
            </a>
            <a asp-controller="Account" asp-action="Settings" class="dropdown-item">
                <i class="fa-regular fa-gear"></i>
                <span>الإعدادات</span>
            </a>
            <div class="dropdown-divider"></div>
            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item logout-item">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>تسجيل خروج</span>
                </button>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const userMenuBtn = document.getElementById('userMenuBtn');
            const userDropdown = document.getElementById('userDropdown');
            const dropdownArrow = document.getElementById('dropdownArrow');
            let isDropdownOpen = false;

            // فتح/إغلاق القائمة المنسدلة
            userMenuBtn.addEventListener('click', function(e) {
                e.stopPropagation();
                isDropdownOpen = !isDropdownOpen;
                userDropdown.classList.toggle('show', isDropdownOpen);
                dropdownArrow.classList.toggle('rotate', isDropdownOpen);
            });

            // إغلاق القائمة عند النقر خارجها
            document.addEventListener('click', function(e) {
                if (!userMenuBtn.contains(e.target) && !userDropdown.contains(e.target)) {
                    isDropdownOpen = false;
                    userDropdown.classList.remove('show');
                    dropdownArrow.classList.remove('rotate');
                }
            });

            // إغلاق القائمة عند الضغط على Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && isDropdownOpen) {
                    isDropdownOpen = false;
                    userDropdown.classList.remove('show');
                    dropdownArrow.classList.remove('rotate');
                }
            });

            // إغلاق القائمة عند تغيير حجم الشاشة
            window.addEventListener('resize', function() {
                if (window.innerWidth > 768 && isDropdownOpen) {
                    isDropdownOpen = false;
                    userDropdown.classList.remove('show');
                    dropdownArrow.classList.remove('rotate');
                }
            });
        });
    </script>
}
else
{
    <button class="icon-btn login-btn" id="loginBtn" type="button" onclick="window.location.href='/Account/Login'">
        <i class="fa-solid fa-right-to-bracket"></i>
        <span>دخول</span>
    </button>
}
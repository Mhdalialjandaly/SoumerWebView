    }

    .cd-price-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .cd-old-price {
        text-decoration: line-through;
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.95rem;
    }

    .cd-new-price {
        font-size: 1.7rem;
        font-weight: 900;
        color: #fff;
    }

        .cd-new-price small {
            font-size: 0.75rem;

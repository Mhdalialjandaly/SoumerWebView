            background: linear-gradient(135deg, #d97706, #b45309);
        }

        .cd-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1), transparent 70%);
            pointer-events: none;
        }

    .cd-hero-ribbon {
        position: absolute;
        top: 16px;
        left: 16px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(6px);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;

    }

    .cd-hero-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto var(--spacing-md);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;

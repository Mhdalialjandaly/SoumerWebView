@model CourseDetailViewModel
@{
    ViewData["Title"] = Model.Course.Name;
}

<div class="course-details-page">

    <!-- ==========================================
         رأس الصفحة
         ========================================== -->
    <div class="cd-header">
        <a href="/Course/Index" class="cd-back-btn">
            <i class="fas fa-arrow-right"></i>
        </a>
        <h1 class="cd-page-title">تفاصيل الكورس</h1>
    </div>

    <!-- ==========================================
         بطاقة الكورس الرئيسية
         ========================================== -->
    <div class="cd-hero @(Model.HasActiveDiscount ? "has-discount" : "")">
        @if (Model.HasActiveDiscount)
        {
            <div class="cd-hero-ribbon">
                <i class="fas fa-fire"></i>
                خصم @Model.Course.DiscountPercent%
            </div>
        }

        <div class="cd-hero-icon">
            <i class="fas fa-book-open"></i>
        </div>

        <h2 class="cd-hero-name">@Model.Course.Name</h2>

        <p class="cd-hero-description">
            @(string.IsNullOrWhiteSpace(Model.Course.Description) ? "لا يوجد وصف" : Model.Course.Description)
        </p>

        <!-- السعر -->
        <div class="cd-price-block">
            @if (Model.HasActiveDiscount)
            {
                <span class="cd-old-price">@Model.Course.Price.ToString("N0") نقطة</span>
                <span class="cd-new-price">@Model.EffectivePrice.ToString("N0") <small>نقطة</small></span>
                <div class="cd-discount-badge">
                    <i class="fas fa-clock"></i>
                    @if (Model.DiscountDaysLeft > 0)
                    {
                        <span>ينتهي العرض بعد @Model.DiscountDaysLeft يوم</span>
                    }
                    else
                    {
                        <span>ينتهي العرض اليوم</span>
                    }
                </div>
            }
            else
            {
                <span class="cd-normal-price">@Model.Course.Price.ToString("N0") <small>نقطة</small></span>
            }
        </div>
    </div>

    <!-- ==========================================
         المعلومات السريعة (Meta)
         ========================================== -->
    <div class="cd-meta-grid">
        <div class="cd-meta-card">
            <div class="cd-meta-icon cd-meta-icon-blue">
                <i class="fas fa-video"></i>
            </div>
            <div class="cd-meta-body">
                <span class="cd-meta-value">@Model.TotalVideos</span>
                <span class="cd-meta-label">فيديو</span>
            </div>
        </div>
        <div class="cd-meta-card">
            <div class="cd-meta-icon cd-meta-icon-green">
                <i class="fas fa-gift"></i>
            </div>
            <div class="cd-meta-body">
                <span class="cd-meta-value">@Model.FreeVideos</span>
                <span class="cd-meta-label">مجاني</span>
            </div>
        </div>
        <div class="cd-meta-card">
            <div class="cd-meta-icon cd-meta-icon-purple">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="cd-meta-body">
                <span class="cd-meta-value">@Model.Course.CreatedAt.ToString("yyyy/MM")</span>
                <span class="cd-meta-label">الإضافة</span>
            </div>
        </div>
    </div>

    <!-- ==========================================
         قائمة الأساتذة
         ========================================== -->
    @if (Model.Teachers.Any())
    {
        <div class="cd-card">
            <div class="cd-card-head">
                <h3><i class="fas fa-chalkboard-teacher"></i> الأساتذة</h3>
                <span class="cd-count-pill">@Model.Teachers.Count</span>
            </div>
            <div class="cd-teachers-list">
                @foreach (var teacher in Model.Teachers)
                {
                    <div class="cd-teacher-item">
                        <div class="cd-teacher-avatar">
                            <img src="@(string.IsNullOrEmpty(teacher.Image) ? "/images/default-avatar.png" : teacher.Image)"
                                 alt="@teacher.Name" />
                        </div>
                        <div class="cd-teacher-info">
                            <h4>@teacher.Name</h4>
                            <span>@teacher.Subject</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ==========================================
         بطاقة الإجراء الرئيسية
         ========================================== -->
    <div class="cd-action-card @(Model.IsEnrolled ? "enrolled" : (Model.CanEnroll ? "available" : "blocked"))">

        @if (Model.IsEnrolled)
        {
            <div class="cd-action-status">
                <div class="cd-status-icon success">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="cd-status-text">
                    <h3>أنت مسجل في هذا الكورس</h3>
                    <p>ابدأ المشاهدة الآن واستكمل تقدمك</p>
                </div>
            </div>

            <div class="cd-action-buttons">
                <a href="/Course/CourseVideos?courseId=@Model.Course.Id" class="cd-btn cd-btn-primary">
                    <i class="fas fa-play-circle"></i>
                    <span>مشاهدة الفيديوهات</span>
                </a>
                <button type="button" class="cd-btn cd-btn-ghost" onclick="unenrollFromCourse()">
                    <i class="fas fa-times"></i>
                    <span>إلغاء التسجيل</span>
                </button>
            </div>
        }
        else if (Model.CanEnroll)
        {
            <div class="cd-action-status">
                <div class="cd-status-icon primary">
                    <i class="fas fa-lock-open"></i>
                </div>
                <div class="cd-status-text">
                    <h3>سجّل الآن وابدأ التعلم</h3>
                    <p>
                        رصيدك:
                        <strong>@Model.UserBalance.ToString("N0")</strong> نقطة
                        @if (Model.HasActiveDiscount)
                        {
                            <span class="cd-save-badge">
                                توفير @Model.Course.DiscountAmount.ToString("N0") نقطة
                            </span>
                        }
                    </p>
                </div>
            </div>

            <div class="cd-action-buttons">
                <button type="button" class="cd-btn cd-btn-primary @(Model.HasActiveDiscount ? "with-discount" : "")" onclick="enrollInCourse()">
                    <i class="fas @(Model.HasActiveDiscount ? "fa-fire" : "fa-shopping-cart")"></i>
                    <span>
                        @if (Model.HasActiveDiscount)
                        {
                            @:اشترك بسعر العرض - @Model.EffectivePrice.ToString("N0") نقطة
                        }
                        else
                        {
                            @:تسجيل الآن - @Model.Course.Price.ToString("N0") نقطة
                        }
                    </span>
                </button>
            </div>
        }
        else
        {
            <div class="cd-action-status">
                <div class="cd-status-icon warning">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="cd-status-text">
                    <h3>لا يمكنك التسجيل الآن</h3>
                    <p>@Model.EnrollmentMessage</p>
                </div>
            </div>

            @if (Model.UserBalance < Model.EffectivePrice)
            {
                <div class="cd-action-buttons">
                    <a href="/Balance/Index" class="cd-btn cd-btn-warning">
                        <i class="fas fa-wallet"></i>
                        <span>شحن الرصيد</span>
                    </a>
                </div>
            }
        }
    </div>

    <!-- ==========================================
         معلومات إضافية
         ========================================== -->
    <div class="cd-card">
        <div class="cd-card-head">
            <h3><i class="fas fa-info-circle"></i> معلومات إضافية</h3>
        </div>
        <div class="cd-info-rows">
            <div class="cd-info-row">
                <span class="cd-info-label">المستوى</span>
                <span class="cd-info-value">مبتدئ - متقدم</span>
            </div>
            <div class="cd-info-row">
                <span class="cd-info-label">الشهادة</span>
                <span class="cd-info-value">شهادة إتمام</span>
            </div>
            <div class="cd-info-row">
                <span class="cd-info-label">عدد الفيديوهات</span>
                <span class="cd-info-value">@Model.TotalVideos فيديو</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* ==========================================
           تنسيقات صفحة تفاصيل الكورس
           ========================================== */

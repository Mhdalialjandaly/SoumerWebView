        background: rgba(255, 255, 255, 0.2);
        padding: 4px 12px;
        border-radius: 14px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: 6px;
    }

    /* ---------- شبكة المعلومات ---------- */
    .cd-meta-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--spacing-sm);
    }

    .cd-meta-card {
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: var(--spacing-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        box-shadow: var(--shadow-sm);
    }

    .cd-meta-icon {
        width: 42px;
        height: 42px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .cd-meta-icon-blue {
        background: #dbeafe;
        color: #2563eb;
    }

    .cd-meta-icon-green {
        background: #d1fae5;
        color: #059669;
    }

    .cd-meta-icon-purple {
        background: var(--primary-soft);
        color: var(--primary-color);
    }

    .cd-meta-body {
        text-align: center;
    }

    .cd-meta-value {
        display: block;
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--text-color);
        line-height: 1.2;
    }

    .cd-meta-label {
        font-size: 0.7rem;
        color: var(--icon-color);
        font-weight: 600;
    }

    /* ---------- بطاقة عامة ---------- */
    .cd-card {
        background: var(--white);
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .cd-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--light-bg);
        border-bottom: 1px solid var(--border-color);
    }

        .cd-card-head h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--text-color);
            margin: 0;
        }

            .cd-card-head h3 i {
                color: var(--primary-color);
            }

    .cd-count-pill {
        background: var(--primary-color);
        color: var(--white);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    /* ---------- الأساتذة ---------- */
    .cd-teachers-list {
        padding: var(--spacing-md);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .cd-teacher-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        padding: var(--spacing-sm);
        border-radius: var(--radius-md);
        transition: background 0.2s;
    }

        .cd-teacher-item:hover {
            background: var(--light-bg);
        }

    .cd-teacher-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--primary-soft);
        flex-shrink: 0;
    }

        .cd-teacher-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .cd-teacher-info h4 {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-color);
    }

    .cd-teacher-info span {
        font-size: 0.72rem;
        color: var(--icon-color);
    }

    /* ---------- بطاقة الإجراء ---------- */
    .cd-action-card {
        background: var(--white);
        border-radius: var(--radius-xl);
        border: 2px solid var(--border-color);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

        .cd-action-card.enrolled {
            border-color: #a7f3d0;
            background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        }

        .cd-action-card.available {
            border-color: var(--primary-soft);
            background: linear-gradient(135deg, #faf5ff, #f0ebf8);
        }

        .cd-action-card.blocked {
            border-color: #fecaca;
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
        }

    .cd-action-status {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-md);
    }

    .cd-status-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

        .cd-status-icon.success {
            background: #10b981;
            color: #fff;
        }

        .cd-status-icon.primary {
            background: var(--primary-color);
            color: #fff;
        }

        .cd-status-icon.warning {
            background: #f59e0b;
            color: #fff;
        }

    .cd-status-text h3 {
        font-size: 0.95rem;
        font-weight: 800;
        margin: 0 0 4px;
        color: var(--text-color);
    }

    .cd-status-text p {
        font-size: 0.8rem;
        color: var(--icon-color);
        margin: 0;
        line-height: 1.5;
    }

    .cd-save-badge {
        display: inline-block;
        margin-right: 6px;
        padding: 1px 8px;
        background: #fef3c7;
        color: #b45309;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .cd-action-buttons {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .cd-btn {
        flex: 1;
        min-width: 140px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        border-radius: var(--radius-md);
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .cd-btn-primary {
        background: var(--primary-color);
        color: #fff;
        box-shadow: 0 4px 12px rgba(33, 0, 87, 0.25);
    }

        .cd-btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            color: #fff;
        }

        .cd-btn-primary.with-discount {
            background: linear-gradient(135deg, #d97706, #b45309);
            box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35);
        }

            .cd-btn-primary.with-discount:hover {
                background: linear-gradient(135deg, #b45309, #92400e);
            }

    .cd-btn-ghost {
        background: transparent;
        color: #dc2626;
        border: 2px solid #fecaca;
    }

        .cd-btn-ghost:hover {
            background: #fee2e2;
            border-color: #dc2626;
        }

    .cd-btn-warning {
        background: #f59e0b;
        color: #fff;
    }

        .cd-btn-warning:hover {
            background: #d97706;
            color: #fff;
        }

    /* ---------- المعلومات الإضافية ---------- */
    .cd-info-rows {
        padding: 0 var(--spacing-lg) var(--spacing-md);
    }

    .cd-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--spacing-md) 0;
        border-bottom: 1px dashed var(--border-color);
    }

        .cd-info-row:last-child {
            border-bottom: none;
        }

    .cd-info-label {
        font-size: 0.8rem;
        color: var(--icon-color);
        font-weight: 600;
    }

    .cd-info-value {
        font-size: 0.85rem;
        color: var(--text-color);
        font-weight: 700;
    }

    /* ---------- استجابة ---------- */
    @@media (max-width: 360px) {
        .course-details-page

    {
        padding: var(--spacing-md);
    }

    .cd-meta-grid {
        gap: 6px;
    }

    .cd-meta-card {
        padding: var(--spacing-sm);
    }

    .cd-meta-icon {
        width: 36px;
        height: 36px;
        font-size: 0.85rem;
    }

    .cd-action-buttons {
        flex-direction: column;
    }

    .cd-btn {
        width: 100%;
    }

    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const courseId = @Model.Course.Id;
        const effectivePrice = @Model.EffectivePrice;
        const originalPrice = @Model.Course.Price;
        const courseName = @Html.Raw(Json.Serialize(Model.Course.Name));
        const hasDiscount = @(Model.HasActiveDiscount.ToString().ToLower());

        // ==========================================
        // التسجيل
        // ==========================================
        function enrollInCourse() {
            const priceInfo = hasDiscount
                ? `<div style="text-align:right; margin-top:10px;">
                       <div style="color:#9496a5; text-decoration:line-through; font-size:0.85rem;">
                           ${Number(originalPrice).toLocaleString()} نقطة
                       </div>
                       <div style="color:#059669; font-size:1.2rem; font-weight:800;">
                           ${Number(effectivePrice).toLocaleString()} نقطة
                           <span style="font-size:0.7rem; background:#fef3c7; color:#b45309; padding:2px 8px; border-radius:8px; margin-right:6px;">🔥 عرض</span>
                       </div>
                   </div>`
                : `<div style="margin-top:10px; color:#210057; font-weight:800; font-size:1.1rem;">
                       ${Number(originalPrice).toLocaleString()} نقطة
                   </div>`;

            Swal.fire({
                title: 'تأكيد التسجيل',
                html: `
                    <div style="text-align:right;">
                        <p style="margin:0; font-size:0.9rem;">هل تريد التسجيل في كورس</p>
                        <strong style="color:#210057; font-size:1rem;">"${courseName}"</strong>
                        <p style="margin:8px 0 0; font-size:0.85rem; color:#9496a5;">سيتم خصم المبلغ التالي من رصيدك:</p>
                        ${priceInfo}
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، سجلني',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#210057',
                cancelButtonColor: '#9496a5'
            }).then(async (result) => {
                if (!result.isConfirmed) return;

                try {
                    const response = await fetch(`/Course/Enroll?courseId=${courseId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                        }
                    });
                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            title: '🎉 تم التسجيل بنجاح',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'ابدأ المشاهدة',
                            confirmButtonColor: '#210057',
                            showCancelButton: true,
                            cancelButtonText: 'البقاء هنا',
                            cancelButtonColor: '#9496a5'
                        }).then((r) => {
                            if (r.isConfirmed) {
                                window.location.href = `/Course/CourseVideos?courseId=${courseId}`;
                            } else {
                                location.reload();
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'تعذر التسجيل',
                            text: data.message,
                            icon: 'error',
                            confirmButtonColor: '#210057'
                        });
                    }
                } catch {
                    Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
                }
            });
        }

        // ==========================================
        // إلغاء التسجيل
        // ==========================================
        function unenrollFromCourse() {
            Swal.fire({
                title: 'تأكيد إلغاء التسجيل',
                text: 'هل تريد إلغاء تسجيلك في هذا الكورس؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'نعم، إلغاء',
                cancelButtonText: 'تراجع',
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#9496a5'
            }).then(async (result) => {
                if (!result.isConfirmed) return;

                try {
                    const response = await fetch(`/Course/Unenroll?courseId=${courseId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                        }
                    });
                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            title: 'تم إلغاء التسجيل',
                            text: data.message,
                            icon: 'success',
                            confirmButtonColor: '#210057'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('خطأ', data.message, 'error');
                    }
                } catch {
                    Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
                }
            });
        }
    </script>
}
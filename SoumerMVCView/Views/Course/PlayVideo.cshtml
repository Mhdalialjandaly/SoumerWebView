@model CourseVideoDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4" dir="rtl">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3>@Model.Title</h3>
        </div>
        <div class="card-body">
            <div class="embed-responsive embed-responsive-16by9" style="min-height: 400px;">
                @if (Model.Platform == VideoPlatform.YouTube)
                {
                    <iframe class="embed-responsive-item"
                            src="@(Model.EmbedUrl ?? $"https://www.youtube.com/embed/{Model.VideoId}?autoplay=1&rel=0")"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                            style="width: 100%; height: 500px;">
                    </iframe>
                }
                else if (Model.Platform == VideoPlatform.Vimeo)
                {
                    <iframe class="embed-responsive-item"
                            src="@(Model.EmbedUrl ?? $"https://player.vimeo.com/video/{Model.VideoId}?autoplay=1&title=0&byline=0&portrait=0")"
                            allow="autoplay; fullscreen; picture-in-picture"
                            allowfullscreen
                            style="width: 100%; height: 500px;">
                    </iframe>
                }
                else
                {
                    <div class="alert alert-warning">نوع الفيديو غير مدعوم</div>
                }
            </div>
            <hr />
            <p><strong>الوصف:</strong> @(Model.Description ?? "لا يوجد وصف")</p>
            <p><strong>المدة:</strong> @(Model.Duration > 0 ? $"{Model.Duration / 60}:{Model.Duration % 60:D2}" : "غير محدد")</p>
            <a asp-controller="Course" asp-action="CourseVideos" asp-route-courseId="@Model.CourseId" class="btn btn-secondary">
                ← العودة إلى قائمة الفيديوهات
            </a>
        </div>
    </div>
</div>
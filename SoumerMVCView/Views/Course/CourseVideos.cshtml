@model CourseVideosViewModel
@using Core.Enums
@{
    ViewData["Title"] = $"فيديوهات - {Model.CourseName}";
    var firstVideo = Model.Videos?.FirstOrDefault();
}

<div class="videos-page">

    <!-- ==========================================
         رأس الصفحة
         ========================================== -->
    <div class="videos-page-header">
        <a href="/MyCourses/Index" class="videos-back-btn">
            <i class="fas fa-arrow-right"></i>
        </a>
        <div class="videos-page-header-info">
            <h1 class="videos-page-title">@Model.CourseName</h1>
            <p class="videos-page-subtitle">
                <i class="fas fa-video"></i>
                @Model.TotalVideos فيديو
                @if (Model.ProgressPercentage > 0)
                {
                    <span class="videos-progress-pill">
                        <i class="fas fa-chart-line"></i>
                        تقدم @Model.ProgressPercentage%
                    </span>
                }
            </p>
        </div>
    </div>

    @if (Model.Videos != null && Model.Videos.Any())
    {
        <!-- ==========================================
             مشغل الفيديو الرئيسي
             ========================================== -->
        <div class="video-player-card">
            <div class="video-player-frame" id="videoPlayerFrame">
                <iframe id="currentVideo"
                        src="@(firstVideo.Platform == VideoPlatform.YouTube
                                                         ? $"https://www.youtube.com/embed/{firstVideo.VideoId}?autoplay=0&rel=0"
                                                         : firstVideo.Platform == VideoPlatform.Vimeo
                                                             ? $"https://player.vimeo.com/video/{firstVideo.VideoId}"
                                                             : firstVideo.EmbedUrl)"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen>
            </iframe>
        </div>

            <div class="video-player-info">
                <h2 class="video-current-title" id="currentVideoTitle">@firstVideo.Title</h2>
                <p class="video-current-description" id="currentVideoDescription">
                    @(string.IsNullOrWhiteSpace(firstVideo.Description) ? "لا يوجد وصف" : firstVideo.Description)
                </p>

                <div class="video-actions-row">
                    <button class="video-action-btn" type="button" onclick="shareVideo()">
                        <i class="fas fa-share-alt"></i>
                        مشاركة
                    </button>
                    <button class="video-action-btn video-action-btn-warn" type="button" onclick="reportVideo()">
                        <i class="fas fa-flag"></i>
                        إبلاغ
                    </button>
                </div>
            </div>
        </div>

        <!-- ==========================================
             قائمة الفيديوهات
             ========================================== -->
        <div class="videos-list-card">
            <div class="videos-list-card-head">
                <h3>
                    <i class="fas fa-list"></i>
                    قائمة الفيديوهات
                </h3>
                <span class="videos-count-pill">@Model.TotalVideos</span>
            </div>

            <div class="videos-list" id="videosList">
            @foreach (var video in Model.Videos)
                {
                    var isActive = video.Id == firstVideo.Id;
                    var thumbnail = video.Platform == VideoPlatform.YouTube
                    ? $"https://img.youtube.com/vi/{video.VideoId}/mqdefault.jpg"
                    : video.Platform == VideoPlatform.Vimeo
                    ? $"https://vumbnail.com/{video.VideoId}.jpg"
                    : "/images/video-placeholder.jpg";

                    <div class="video-list-item @(isActive ? "active" : "")"
                         data-video-id="@video.Id"
                         data-video-title="@video.Title"
                         data-video-description="@(video.Description ?? "")"
                         data-video-platform="@((int)video.Platform)"
                         data-video-videoid="@video.VideoId"
                         data-video-embedurl="@video.EmbedUrl"
                         onclick="selectVideo(this)">
                        <div class="video-thumb">
                            <img src="@thumbnail" alt="@video.Title" loading="lazy" />
                            <div class="video-thumb-overlay">
                                <i class="fas fa-play"></i>
                            </div>
                            @if (video.Duration > 0)
                            {
                                <span class="video-duration-pill">
                                    @(video.Duration / 60):@((video.Duration % 60).ToString("D2"))
                                </span>
                            }
                        </div>

                        <div class="video-item-body">
                            <h4 class="video-item-title">@video.Title</h4>
                            <div class="video-item-meta">
                                @if (video.IsFree)
                                {
                                    <span class="video-tag video-tag-free">
                                        <i class="fas fa-gift"></i>
                                        مجاني
                                    </span>
                                }
                                else
                                {
                                    <span class="video-tag video-tag-premium">
                                        <i class="fas fa-gem"></i>
                                        مدفوع
                                    </span>
                                }
                                <span class="video-tag video-tag-order">#@video.Order</span>
                            </div>
                        </div>

                        <i class="fas fa-chevron-left video-item-arrow"></i>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <!-- ==========================================
             حالة فارغة
             ========================================== -->
        <div class="videos-empty">
            <div class="videos-empty-icon"><i class="fas fa-video-slash"></i></div>
            <h2>لا توجد فيديوهات بعد</h2>
            <p>لم تُضف أي فيديوهات لهذا المادة حتى الآن</p>
            <a href="/MyCourses/Index" class="videos-empty-btn">
                <i class="fas fa-arrow-right"></i>
                العودة إلى موادي
            </a>
        </div>
    }
</div>

<style>
    /* ==========================================
           تنسيقات صفحة الفيديوهات - تعتمد على متغيرات site.css
           ========================================== */
    .videos-page {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    /* ---------- رأس الصفحة ---------- */
    .videos-page-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .videos-back-btn {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--white);
        border: 1px solid var(--border-color);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
        text-decoration: none;
        box-shadow: var(--shadow-sm);
        transition: all 0.2s ease;
    }

        .videos-back-btn:hover {
            background: var(--primary-color);
            color: var(--white);
            border-color: var(--primary-color);
            transform: translateX(-2px);
        }

    .videos-page-header-info {
        flex: 1;
        min-width: 0;
    }

    .videos-page-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--text-color);
        margin: 0 0 4px 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .videos-page-subtitle {
        font-size: 0.75rem;
        color: var(--icon-color);
        margin: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

        .videos-page-subtitle i {
            color: var(--primary-color);
        }

    .videos-progress-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--primary-soft);
        color: var(--primary-color);
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    /* ---------- بطاقة المشغل ---------- */
    .video-player-card {
        background: var(--white);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-color);
    }

    .video-player-frame {
        position: relative;
        width: 100%;
        aspect-ratio: 16/9;
        background: #000;
    }

        .video-player-frame iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

    .video-player-info {
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .video-current-title {
        font-size: 1rem;
        font-weight: 800;
        color: var(--text-color);
        margin: 0;
        line-height: 1.4;
    }

    .video-current-description {
        font-size: 0.8rem;
        color: var(--icon-color);
        line-height: 1.6;
        margin: 0;
    }

    .video-actions-row {
        display: flex;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .video-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: var(--radius-md);
        background: var(--primary-soft);
        color: var(--primary-color);
        border: none;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.75rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .video-action-btn:hover {
            background: var(--primary-color);
            color: var(--white);
        }

    .video-action-btn-warn {
        background: #fef3c7;
        color: #b45309;
    }

        .video-action-btn-warn:hover {
            background: #d97706;
            color: var(--white);
        }

    /* ---------- بطاقة قائمة الفيديوهات ---------- */
    .videos-list-card {
        background: var(--white);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .videos-list-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--primary-soft);
        border-bottom: 1px solid var(--border-color);
    }

        .videos-list-card-head h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--primary-color);
            margin: 0;
        }

    .videos-count-pill {
        background: var(--primary-color);
        color: var(--white);
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .videos-list {
        display: flex;
        flex-direction: column;
    }

    /* ---------- عنصر فيديو ---------- */
    .video-list-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        padding: var(--spacing-md);
        cursor: pointer;
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--border-color);
        position: relative;
    }

        .video-list-item:last-child {
            border-bottom: none;
        }

        .video-list-item:hover {
            background: var(--light-bg);
        }

        .video-list-item.active {
            background: var(--primary-soft);
        }

            .video-list-item.active::before {
                content: '';
                position: absolute;
                top: 0;
                bottom: 0;
                right: 0;
                width: 3px;
                background: var(--primary-color);
            }

    .video-thumb {
        position: relative;
        width: 96px;
        height: 60px;
        border-radius: var(--radius-md);
        overflow: hidden;
        flex-shrink: 0;
        background: #000;
    }

        .video-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .video-thumb-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.35);
        color: #fff;
        font-size: 0.8rem;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .video-list-item:hover .video-thumb-overlay,
    .video-list-item.active .video-thumb-overlay {
        opacity: 1;
    }

    .video-list-item.active .video-thumb-overlay {
        background: rgba(33, 0, 87, 0.5);
    }

    .video-duration-pill {
        position: absolute;
        bottom: 4px;
        left: 4px;
        background: rgba(0, 0, 0, 0.75);
        color: #fff;
        padding: 1px 6px;
        border-radius: 6px;
        font-size: 0.6rem;
        font-weight: 700;
    }

    .video-item-body {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .video-item-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--text-color);
        margin: 0;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 1.35;
    }

    .video-list-item.active .video-item-title {
        color: var(--primary-color);
    }

    .video-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .video-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 0.65rem;
        font-weight: 700;
    }

    .video-tag-free {
        background: #d1fae5;
        color: #059669;
    }

    .video-tag-premium {
        background: var(--primary-soft);
        color: var(--primary-color);
    }

    .video-tag-order {
        background: var(--light-bg);
        color: var(--icon-color);
        border: 1px solid var(--border-color);
    }

    .video-item-arrow {
        color: var(--icon-color);
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .video-list-item.active .video-item-arrow {
        color: var(--primary-color);
    }

    /* ---------- حالة فارغة ---------- */
    .videos-empty {
        background: var(--white);
        border-radius: var(--radius-xl);
        padding: var(--spacing-2xl);
        text-align: center;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .videos-empty-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto var(--spacing-md);
        border-radius: 50%;
        background: var(--primary-soft);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .videos-empty h2 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--text-color);
        margin: 0 0 6px;
    }

    .videos-empty p {
        font-size: 0.8rem;
        color: var(--icon-color);
        margin: 0 0 var(--spacing-lg);
    }

    .videos-empty-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--primary-color);
        color: var(--white);
        padding: 10px 18px;
        border-radius: var(--radius-md);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }

        .videos-empty-btn:hover {
            background: var(--primary-dark);
            color: var(--white);
        }

    /* ---------- استجابة للشاشات ---------- */
    @@media (min-width: 900px) {
        .videos-page {
            max-width: 1000px;
        }
        /* تخطيط عمودي على الشاشات الكبيرة: مشغل + قائمة جانبية */
        .videos-page {
            display: grid;
            grid-template-columns: 1fr 320px;
            grid-template-areas:
                "header header"
                "player list";
            gap: var(--spacing-lg);
            align-items: start;
        }

        .videos-page-header {
            grid-area: header;
        }

        .video-player-card {
            grid-area: player;
        }

        .videos-list-card {
            grid-area: list;
            max-height: calc(100vh - 200px);
            overflow-y: auto;
        }
    }

    @@media (max-width: 360px) {
        .videos-page {
            padding: var(--spacing-md);
        }

        .video-thumb {
            width: 80px;
            height: 50px;
        }

        .video-item-title {
            font-size: 0.78rem;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentVideo = null;

        // ==========================================
        // اختيار فيديو
        // ==========================================
        function selectVideo(element) {
            document.querySelectorAll('.video-list-item').forEach(item => item.classList.remove('active'));
            element.classList.add('active');

            const videoId = element.dataset.videoId;
            const videoTitle = element.dataset.videoTitle;
            const videoDescription = element.dataset.videoDescription;
            const platform = parseInt(element.dataset.videoPlatform);
            const videoVideoId = element.dataset.videoVideoid;
            const embedUrl = element.dataset.videoEmbedurl;

            document.getElementById('currentVideoTitle').textContent = videoTitle;
            document.getElementById('currentVideoDescription').textContent =
                videoDescription || 'لا يوجد وصف';

            const iframe = document.getElementById('currentVideo');
            let finalUrl = embedUrl || '';

            if (platform === 1) { // YouTube
                finalUrl = `https://www.youtube.com/embed/${videoVideoId}?autoplay=1&rel=0`;
            } else if (platform === 2) { // Vimeo
                finalUrl = `https://player.vimeo.com/video/${videoVideoId}?autoplay=1`;
            }

            iframe.src = finalUrl;

            currentVideo = { id: videoId, title: videoTitle };
            trackVideoView(videoId);

            // تمرير إلى المشغل على الموبايل
            if (window.innerWidth < 900) {
                document.querySelector('.video-player-card')
                    ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // ==========================================
        // تتبع المشاهدة
        // ==========================================
        async function trackVideoView(videoId) {
            try {
                await fetch(`/Course/TrackVideoView?videoId=${videoId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                    }
                });
            } catch (error) {
                console.error('Error tracking video view:', error);
            }
        }

        // ==========================================
        // مشاركة
        // ==========================================
        function shareVideo() {
            if (!currentVideo) return;
            const url = window.location.href;
            const text = `شاهد الفيديو: ${currentVideo.title} على منصة سومر التعليمية`;

            if (navigator.share) {
                navigator.share({ title: currentVideo.title, text: text, url: url })
                    .catch(() => copyToClipboard(url));
            } else {
                copyToClipboard(url);
            }
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                Swal.fire({
                    title: 'تم النسخ',
                    text: 'تم نسخ رابط الفيديو إلى الحافظة',
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false,
                    confirmButtonColor: '#210057'
                });
            });
        }

        // ==========================================
        // إبلاغ
        // ==========================================
        function reportVideo() {
            if (!currentVideo) return;

            Swal.fire({
                title: 'الإبلاغ عن مشكلة',
                html: `
                    <div style="text-align: right;">
                        <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">هل تواجه مشكلة في مشاهدة الفيديو؟</p>
                        <textarea id="reportMessage" class="swal2-textarea"
                                  placeholder="صف المشكلة التي تواجهها..."
                                  rows="3"
                                  style="font-family: inherit;"></textarea>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'إرسال',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#210057',
                cancelButtonColor: '#9496a5',
                preConfirm: () => {
                    const message = document.getElementById('reportMessage').value;
                    if (!message) {
                        Swal.showValidationMessage('يرجى كتابة وصف المشكلة');
                        return false;
                    }
                    return message;
                }
            }).then(async (result) => {
                if (!result.isConfirmed) return;

                try {
                    const response = await fetch('/Course/ReportVideoIssue', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                        },
                        body: JSON.stringify({
                            videoId: currentVideo.id,
                            message: result.value
                        })
                    });

                    const data = await response.json();
                    Swal.fire({
                        title: data.success ? 'تم الإرسال' : 'خطأ',
                        text: data.success
                            ? 'تم استلام بلاغك وسيتم معالجته قريباً'
                            : 'حدث خطأ في إرسال البلاغ',
                        icon: data.success ? 'success' : 'error',
                        confirmButtonColor: '#210057'
                    });
                } catch {
                    Swal.fire({
                        title: 'خطأ',
                        text: 'حدث خطأ في الاتصال بالخادم',
                        icon: 'error',
                        confirmButtonColor: '#210057'
                    });
                }
            });
        }

        // ==========================================
        // حفظ التقدم (اختياري)
        // ==========================================
        let watchTime = 0;
        let videoDuration = 0;

        window.addEventListener('message', function (event) {
            if (event.data && event.data.event === 'timeupdate') {
                watchTime = event.data.currentTime;
                videoDuration = event.data.duration;
                if (Math.floor(watchTime) % 10 === 0) saveProgress();
            }
        });

        function saveProgress() {
            if (!currentVideo || videoDuration <= 0) return;
            const progress = (watchTime / videoDuration) * 100;
            fetch('/Course/SaveVideoProgress', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                },
                body: JSON.stringify({
                    videoId: currentVideo.id,
                    progress: progress,
                    watchTime: watchTime
                })
            }).catch(error => console.error('Error saving progress:', error));
        }

        window.addEventListener('beforeunload', saveProgress);

        // ==========================================
        // لوحة المفاتيح
        // ==========================================
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
            const current = document.querySelector('.video-list-item.active');
            if (!current) return;

            const target = e.key === 'ArrowUp'
                ? current.previousElementSibling
                : current.nextElementSibling;

            if (target && target.classList.contains('video-list-item')) {
                target.click();
                target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        });

        // ==========================================
        // تهيئة
        // ==========================================
        document.addEventListener('DOMContentLoaded', function () {
            const activeItem = document.querySelector('.video-list-item.active');
            if (activeItem) {
                currentVideo = {
                    id: activeItem.dataset.videoId,
                    title: activeItem.dataset.videoTitle
                };
            }
        });
    </script>
}
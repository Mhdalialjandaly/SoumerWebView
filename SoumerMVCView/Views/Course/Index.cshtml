@model CourseListViewModel
@{
    ViewData["Title"] = "جميع المواد";
}

<div class="courses-index-page">

    <!-- ==========================================
         رأس الصفحة
         ========================================== -->
    <div class="courses-index-header">
        <div class="courses-index-header-info">
            <h1 class="courses-index-title">
                <i class="fas fa-book-open"></i>
                جميع المواد
            </h1>
            <p class="courses-index-subtitle">
                اكتشف المواد التعليمية وابدأ رحلتك المعرفية
            </p>
        </div>

        <!-- بطاقة الرصيد -->
        <a href="/Balance/Index" class="balance-chip">
            <div class="balance-chip-icon">
                <i class="fas fa-gem"></i>
            </div>
            <div class="balance-chip-body">
                <span class="balance-chip-label">رصيدك</span>
                <span class="balance-chip-value">@Model.UserBalance.ToString("N0")</span>
            </div>
            <i class="fas fa-chevron-left balance-chip-arrow"></i>
        </a>
    </div>

    <!-- ==========================================
         إحصائيات سريعة
         ========================================== -->
    <div class="courses-stats-row">
        <div class="courses-stat-pill">
            <i class="fas fa-book"></i>
            <span>@Model.TotalCourses مادة</span>
        </div>
        <div class="courses-stat-pill courses-stat-pill-success">
            <i class="fas fa-check-circle"></i>
            <span>@Model.EnrolledCoursesCount مسجل بها</span>
        </div>
    </div>

    <!-- ==========================================
         البحث والترتيب
         ========================================== -->
    <div class="courses-filters">
        <div class="courses-search-box">
            <i class="fas fa-search courses-search-icon"></i>
            <input type="text"
                   id="searchInput"
                   class="courses-search-input"
                   placeholder="ابحث عن مادة..." />
        </div>

        <select id="sortSelect" class="courses-sort-select">
            <option value="name">الاسم</option>
            <option value="price_asc">الأقل سعراً</option>
            <option value="price_desc">الأعلى سعراً</option>
            <option value="newest">الأحدث</option>
        </select>
    </div>

    <!-- ==========================================
         شبكة المواد
         ========================================== -->
    <div class="courses-grid" id="coursesContainer">
        @if (Model.Courses != null && Model.Courses.Any())
        {
            foreach (var course in Model.Courses)
            {
                <div class="course-grid-card @(course.HasActiveDiscount ? "has-discount" : "")"
                     data-course-id="@course.Id"
                     data-name="@course.Name"
                     data-price="@course.EffectivePrice"
                     data-created="@course.CreatedAt.ToString("o")">

                    @if (course.HasActiveDiscount)
                    {
                        <div class="course-ribbon">
                            <i class="fas fa-fire"></i>
                            خصم @course.DiscountPercent%
                        </div>
                    }

            <div class="course-grid-icon">
                <i class="fas fa-book-open"></i>
            </div>

            <h3 class="course-grid-title">@course.Name</h3>

            <p class="course-grid-desc">
                @(string.IsNullOrWhiteSpace(course.Description)
                                ? "لا يوجد وصف"
                                : (course.Description.Length > 100
                                ? course.Description.Substring(0, 100) + "..."
                                : course.Description))
            </p>

                    <div class="course-grid-price @(course.HasActiveDiscount ? "with-discount" : "")">
                @if (course.HasActiveDiscount)
                        {
                            <span class="old-price">@course.Price.ToString("N0")</span>
                            <span class="new-price">@course.EffectivePrice.ToString("N0")</span>
                            <span class="price-unit">نقطة</span>
                        }
                        else
                        {
                            <span class="new-price">@course.Price.ToString("N0")</span>
                            <span class="price-unit">نقطة</span>
                        }
                    </div>

                    <div class="course-grid-actions">
                        <a href="/Course/Details/@course.Id" class="course-btn course-btn-ghost">
                            <i class="fas fa-info-circle"></i>
                            التفاصيل
                        </a>
                        <button type="button"
                                class="course-btn course-btn-primary @(course.HasActiveDiscount ? "with-discount" : "")"
                                onclick="enrollInCourse(@course.Id, '@Html.Raw(Html.Encode(course.Name))')">
                            <i class="fas @(course.HasActiveDiscount ? "fa-fire" : "fa-shopping-cart")"></i>
                            اشترك
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="courses-empty">
                <div class="courses-empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>لا توجد مواد متاحة حالياً</h3>
                <p>سيتم إضافة مواد جديدة قريباً</p>
            </div>
        }
    </div>

    <!-- ==========================================
         مؤشر التحميل
         ========================================== -->
    <div id="loadingIndicator" class="courses-loading" style="display:none;">
        <div class="courses-loading-spinner"></div>
        <span>جارٍ التحميل...</span>
    </div>
</div>

<style>
    /* ==========================================
           تنسيقات صفحة المواد
           ========================================== */
    .courses-index-page {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: var(--spacing-lg);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-lg);
    }

    /* ---------- رأس الصفحة ---------- */
    .courses-index-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
        flex-wrap: wrap;
    }

    .courses-index-header-info {
        flex: 1;
        min-width: 200px;
    }

    .courses-index-title {
        font-size: 1.15rem;
        font-weight: 900;
        color: var(--text-color);
        margin: 0 0 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .courses-index-title i {
            color: var(--primary-color);
            font-size: 1rem;
        }

    .courses-index-subtitle {
        font-size: 0.78rem;
        color: var(--icon-color);
        margin: 0;
    }

    /* ---------- بطاقة الرصيد ---------- */
    .balance-chip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px 8px 8px;
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        text-decoration: none;
        box-shadow: var(--shadow-sm);
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

        .balance-chip:hover {
            border-color: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .balance-chip-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--primary-soft);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .balance-chip-body {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    .balance-chip-label {
        font-size: 0.65rem;
        color: var(--icon-color);
        font-weight: 500;
    }

    .balance-chip-value {
        font-size: 0.95rem;
        font-weight: 900;
        color: var(--primary-color);
    }

    .balance-chip-arrow {
        font-size: 0.65rem;
        color: var(--icon-color);
        margin-right: 2px;
    }

    /* ---------- شريط الإحصائيات ---------- */
    .courses-stats-row {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .courses-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        background: var(--primary-soft);
        color: var(--primary-color);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .courses-stat-pill-success {
        background: #d1fae5;
        color: #059669;
    }

    /* ---------- الفلاتر ---------- */
    .courses-filters {
        display: flex;
        gap: var(--spacing-sm);
    }

    .courses-search-box {
        position: relative;
        flex: 1;
    }

    .courses-search-icon {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--icon-color);
        font-size: 0.85rem;
        pointer-events: none;
    }

    .courses-search-input {
        width: 100%;
        padding: 12px 40px 12px 14px;
        font-size: 0.85rem;
        font-family: inherit;
        color: var(--text-color);
        background: var(--white);
        border: 2px solid var(--border-color);
        border-radius: var(--radius-md);
        transition: all 0.2s ease;
        -webkit-user-select: text;
        user-select: text;
    }

        .courses-search-input:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(33, 0, 87, 0.1);
        }

        .courses-search-input::placeholder {
            color: var(--icon-color);
        }

    .courses-sort-select {
        padding: 12px 14px;
        font-size: 0.8rem;
        font-family: inherit;
        font-weight: 600;
        color: var(--text-color);
        background: var(--white);
        border: 2px solid var(--border-color);
        border-radius: var(--radius-md);
        cursor: pointer;
        min-width: 130px;
    }

        .courses-sort-select:focus {
            outline: none;
            border-color: var(--primary-color);
        }

    /* ---------- شبكة المواد ---------- */
    .courses-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-md);
    }

    .course-grid-card {
        position: relative;
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-xl);
        padding: var(--spacing-lg) var(--spacing-md);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        box-shadow: var(--shadow-sm);
        transition: all 0.2s ease;
        overflow: hidden;
    }

        .course-grid-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
            border-color: var(--primary-color);
        }

        .course-grid-card.has-discount {
            border-color: #fde68a;
        }

            .course-grid-card.has-discount:hover {
                border-color: #d97706;
                box-shadow: 0 6px 20px rgba(217, 119, 6, 0.15);
            }

    /* شارة الخصم */
    .course-ribbon {
        position: absolute;
        top: 10px;
        left: 10px;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 4px;
        box-shadow: 0 2px 6px rgba(217, 119, 6, 0.4);
        z-index: 2;
    }

    /* أيقونة */
    .course-grid-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        background: var(--primary-soft);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    .course-grid-card.has-discount .course-grid-icon {
        background: #fef3c7;
        color: #b45309;
    }

    /* العنوان */
    .course-grid-title {
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--text-color);
        margin: 0;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* الوصف */
    .course-grid-desc {
        font-size: 0.75rem;
        color: var(--icon-color);
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    /* السعر */
    .course-grid-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        padding: var(--spacing-sm);
        background: var(--light-bg);
        border-radius: var(--radius-md);
        margin-top: auto;
    }

        .course-grid-price.with-discount {
            background: #fffbeb;
        }

        .course-grid-price .old-price {
            text-decoration: line-through;
            color: var(--icon-color);
            font-size: 0.75rem;
            font-weight: 500;
        }

        .course-grid-price .new-price {
            font-size: 1.1rem;
            font-weight: 900;
            color: var(--primary-color);
        }

        .course-grid-price.with-discount .new-price {
            color: #059669;
        }

        .course-grid-price .price-unit {
            font-size: 0.65rem;
            color: var(--icon-color);
            font-weight: 600;
        }

    /* الأزرار */
    .course-grid-actions {
        display: flex;
        gap: 6px;
    }

    .course-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 9px 8px;
        border-radius: var(--radius-md);
        font-family: inherit;
        font-size: 0.72rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        white-space: nowrap;
    }

        .course-btn i {
            font-size: 0.7rem;
        }

    .course-btn-ghost {
        background: var(--light-bg);
        color: var(--text-color);
        border: 1px solid var(--border-color);
    }

        .course-btn-ghost:hover {
            background: var(--primary-soft);
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

    .course-btn-primary {
        background: var(--primary-color);
        color: var(--white);
    }

        .course-btn-primary:hover {
            background: var(--primary-dark);
        }

        .course-btn-primary.with-discount {
            background: linear-gradient(135deg, #059669, #047857);
        }

            .course-btn-primary.with-discount:hover {
                background: linear-gradient(135deg, #047857, #065f46);
            }

    /* ---------- حالة فارغة ---------- */
    .courses-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: var(--spacing-2xl);
        background: var(--white);
        border-radius: var(--radius-xl);
        border: 1px dashed var(--border-color);
    }

    .courses-empty-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto var(--spacing-md);
        border-radius: 50%;
        background: var(--primary-soft);
        color: var(--primary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .courses-empty h3 {
        font-size: 1rem;
        font-weight: 800;
        color: var(--text-color);
        margin: 0 0 6px;
    }

    .courses-empty p {
        font-size: 0.8rem;
        color: var(--icon-color);
        margin: 0;
    }

    /* ---------- مؤشر التحميل ---------- */
    .courses-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: var(--spacing-lg);
        color: var(--icon-color);
        font-size: 0.85rem;
    }

    .courses-loading-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid var(--border-color);
        border-top-color: var(--primary-color);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* ---------- استجابة ---------- */
    @@media (max-width: 360px) {
        .courses-index-page {
            padding: var(--spacing-md);
        }

        .courses-grid {
            gap: var(--spacing-sm);
        }

        .course-grid-card {
            padding: var(--spacing-md) var(--spacing-sm);
        }

        .course-grid-actions {
            flex-direction: column;
        }

        .course-btn {
            width: 100%;
        }

        .balance-chip-body {
            display: none;
        }
    }

    @@media (min-width: 600px) {
        .courses-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (min-width: 900px) {
        .courses-index-page {
            max-width: 1000px;
        }

        .courses-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ==========================================
        // العناصر
        // ==========================================
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const coursesContainer = document.getElementById('coursesContainer');
        const loadingIndicator = document.getElementById('loadingIndicator');

        let searchTimeout = null;
        let currentSort = 'name';

        // ==========================================
        // البحث
        // ==========================================
        searchInput?.addEventListener('input', function () {
            clearTimeout(searchTimeout);
            const query = this.value.trim();
            searchTimeout = setTimeout(() => performSearch(query), 400);
        });

        sortSelect?.addEventListener('change', function () {
            currentSort = this.value;
            performSearch(searchInput?.value?.trim() ?? '');
        });

        async function performSearch(query) {
            loadingIndicator.style.display = 'flex';

            try {
                const url = `/Course/Search?query=${encodeURIComponent(query)}&sortBy=${encodeURIComponent(currentSort)}`;
                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    updateCoursesList(data.courses || []);
                }
            } catch (err) {
                console.error(err);
            } finally {
                loadingIndicator.style.display = 'none';
            }
        }

        // ==========================================
        // تحديث الشبكة
        // ==========================================
        function updateCoursesList(courses) {
            if (!courses.length) {
                coursesContainer.innerHTML = `
                    <div class="courses-empty">
                        <div class="courses-empty-icon"><i class="fas fa-search"></i></div>
                        <h3>لا توجد نتائج</h3>
                        <p>لم نجد أي مادة تطابق بحثك</p>
                    </div>`;
                return;
            }

            coursesContainer.innerHTML = courses.map(course => {
                const hasDiscount = course.hasActiveDiscount === true;
                const effectivePrice = Number(course.effectivePrice ?? course.price ?? 0);
                const originalPrice = Number(course.price ?? 0);
                const discountPercent = Number(course.discountPercent ?? 0);

                const description = course.description
                    ? (course.description.length > 100
                        ? course.description.substring(0, 100) + '...'
                        : course.description)
                    : 'لا يوجد وصف';

                const priceHtml = hasDiscount
                    ? `<span class="old-price">${originalPrice.toLocaleString('ar-EG')}</span>
                       <span class="new-price">${effectivePrice.toLocaleString('ar-EG')}</span>
                       <span class="price-unit">نقطة</span>`
                    : `<span class="new-price">${originalPrice.toLocaleString('ar-EG')}</span>
                       <span class="price-unit">نقطة</span>`;

                return `
                    <div class="course-grid-card ${hasDiscount ? 'has-discount' : ''}"
                         data-course-id="${course.id}">
                        ${hasDiscount ? `
                            <div class="course-ribbon">
                                <i class="fas fa-fire"></i>
                                خصم ${discountPercent}%
                            </div>` : ''}
                        <div class="course-grid-icon">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <h3 class="course-grid-title">${escapeHtml(course.name)}</h3>
                        <p class="course-grid-desc">${escapeHtml(description)}</p>
                        <div class="course-grid-price ${hasDiscount ? 'with-discount' : ''}">
                            ${priceHtml}
                        </div>
                        <div class="course-grid-actions">
                            <a href="/Course/Details/${course.id}" class="course-btn course-btn-ghost">
                                <i class="fas fa-info-circle"></i>
                                التفاصيل
                            </a>
                            <button type="button"
                                    class="course-btn course-btn-primary ${hasDiscount ? 'with-discount' : ''}"
                                    onclick="enrollInCourse(${course.id}, '${escapeHtml(course.name).replace(/'/g, "\\'")}')">
                                <i class="fas ${hasDiscount ? 'fa-fire' : 'fa-shopping-cart'}"></i>
                                اشترك
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ==========================================
        // التسجيل
        // ==========================================
        async function enrollInCourse(courseId, courseName) {
            const confirmed = await Swal.fire({
                title: 'تأكيد التسجيل',
                html: `
                    <div style="text-align:right;">
                        <p style="margin:0; font-size:0.9rem;">هل تريد التسجيل في مادة</p>
                        <strong style="color:#210057; font-size:1rem;">"${escapeHtml(courseName)}"</strong>
                        <p style="margin:8px 0 0; font-size:0.8rem; color:#9496a5;">سيتم خصم قيمتها من رصيدك</p>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، سجلني',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#210057',
                cancelButtonColor: '#9496a5'
            });

            if (!confirmed.isConfirmed) return;

            try {
                const response = await fetch(`/Course/Enroll?courseId=${courseId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() || ''
                    }
                });
                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        title: '🎉 تم التسجيل بنجاح',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'ابدأ المشاهدة',
                        confirmButtonColor: '#210057',
                        showCancelButton: true,
                        cancelButtonText: 'البقاء هنا',
                        cancelButtonColor: '#9496a5'
                    }).then(r => {
                        if (r.isConfirmed) {
                            window.location.href = `/Course/CourseVideos?courseId=${courseId}`;
                        } else {
                            location.reload();
                        }
                    });
                } else {
                    Swal.fire('تعذر التسجيل', data.message, 'error');
                }
            } catch {
                Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
            }
        }
    </script>
}
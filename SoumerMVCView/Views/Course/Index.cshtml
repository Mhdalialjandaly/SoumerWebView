@model CourseListViewModel
@{
    ViewData["Title"] = "جميع الكورسات";
}

<div class="container-fluid mt-4" dir="rtl">
    <!-- Header Section -->
    <div class="courses-header-section">
        <div class="header-content">
            <div>
                <h1 class="courses-main-title">📚 جميع الكورسات</h1>
                <p class="courses-subtitle">اكتشف أفضل الكورسات التعليمية وابدأ رحلتك المعرفية</p>
            </div>
            <div class="balance-badge-enhanced">
                <div class="balance-icon">💎</div>
                <div class="balance-info">
                    <div class="balance-label">رصيدك الحالي</div>
                    <div class="balance-value">@Model.UserBalance.ToString("N0") <span>نقطة</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Section -->
    <div class="search-filter-section">
        <div class="search-wrapper">
            <div class="search-icon">🔍</div>
            <input type="text" id="searchInput" class="search-input-enhanced"
                   placeholder="ابحث عن كورس...">
        </div>
        <div class="filter-wrapper">
            <select id="sortSelect" class="filter-select">
                <option value="name">الترتيب حسب الاسم</option>
                <option value="price_asc">الأقل سعراً</option>
                <option value="price_desc">الأعلى سعراً</option>
                <option value="newest">الأحدث</option>
            </select>
        </div>
    </div>

    <!-- Courses Grid -->
    <div class="courses-grid-enhanced" id="coursesContainer">
        @if (Model.Courses != null && Model.Courses.Any())
        {
            foreach (var course in Model.Courses)
            {
                <div class="course-card-enhanced-v2" data-course-id="@course.Id">
                    <div class="course-card-badge">📖 كورس</div>
                    <div class="course-card-content">
                        <h3 class="course-card-title">@course.Name</h3>
                        <p class="course-card-description">
                            @(course.Description?.Length > 100 ? course.Description.Substring(0, 100) + "..." : course.Description)
                        </p>
                        <div class="course-card-price">
                            <span class="price-amount">@course.Price.ToString("N0")</span>
                            <span class="price-unit">نقطة</span>
                        </div>
                        <div class="course-card-footer">
                            <a href="/Course/Details/@course.Id" class="btn-view-details">
                                عرض التفاصيل
                                <span>→</span>
                            </a>
                            <button class="btn-enroll-quick" onclick="enrollInCourse(@course.Id)">
                                تسجيل الآن
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-courses-enhanced">
                <div class="empty-icon">📭</div>
                <h3>لا توجد كورسات متاحة حالياً</h3>
                <p>سيتم إضافة كورسات جديدة قريباً</p>
            </div>
        }
    </div>

    <!-- Loading Indicator -->
    <div id="loadingIndicator" class="loading-indicator" style="display: none;">
        <div class="spinner"></div>
        <p>جاري التحميل...</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let searchTimeout;
        let currentSort = 'name';

        // التسجيل السريع في الكورس
        async function enrollInCourse(courseId) {
            const result = await Swal.fire({
                title: 'تأكيد التسجيل',
                text: 'هل أنت متأكد من رغبتك في التسجيل في هذا الكورس؟',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'نعم، سجلني',
                cancelButtonText: 'إلغاء',
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#64748b'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/Course/Enroll?courseId=${courseId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    });

                    const data = await response.json();

                    if (data.success) {
                        Swal.fire({
                            title: 'تم التسجيل!',
                            text: data.message,
                            icon: 'success',
                            confirmButtonText: 'حسناً',
                            confirmButtonColor: '#10b981'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({
                            title: 'خطأ',
                            text: data.message,
                            icon: 'error',
                            confirmButtonText: 'حسناً',
                            confirmButtonColor: '#ef4444'
                        });
                    }
                } catch (error) {
                    Swal.fire('خطأ', 'حدث خطأ في الاتصال بالخادم', 'error');
                }
            }
        }

        // البحث المتقدم
        $('#searchInput').on('input', function() {
            clearTimeout(searchTimeout);
            const query = $(this).val();

            searchTimeout = setTimeout(() => {
                performSearch(query);
            }, 500);
        });

        // الترتيب
        $('#sortSelect').on('change', function() {
            currentSort = $(this).val();
            performSearch($('#searchInput').val());
        });

        function performSearch(query) {
            $('#loadingIndicator').show();

            $.ajax({
                url: '/Course/Search',
                type: 'GET',
                data: {
                    query: query,
                    sortBy: currentSort
                },
                success: function(response) {
                    if (response.success) {
                        updateCoursesList(response.courses);
                    }
                },
                complete: function() {
                    $('#loadingIndicator').hide();
                }
            });
        }

        function updateCoursesList(courses) {
            const container = $('#coursesContainer');
            container.empty();

            if (courses.length === 0) {
                container.html(`
                    <div class="empty-courses-enhanced">
                        <div class="empty-icon">🔍</div>
                        <h3>لا توجد نتائج</h3>
                        <p>لم نجد أي كورسات تطابق بحثك</p>
                    </div>
                `);
                return;
            }

            courses.forEach(course => {
                const description = course.description ?
                    (course.description.length > 100 ? course.description.substring(0, 100) + '...' : course.description) :
                    'لا يوجد وصف';

                const courseHtml = `
                    <div class="course-card-enhanced-v2" data-course-id="${course.id}">
                        <div class="course-card-badge">📖 كورس</div>
                        <div class="course-card-content">
                            <h3 class="course-card-title">${escapeHtml(course.name)}</h3>
                            <p class="course-card-description">${escapeHtml(description)}</p>
                            <div class="course-card-price">
                                <span class="price-amount">${course.price.toLocaleString()}</span>
                                <span class="price-unit">نقطة</span>
                            </div>
                            <div class="course-card-footer">
                                <a href="/Course/Details/${course.id}" class="btn-view-details">
                                    عرض التفاصيل
                                    <span>→</span>
                                </a>
                                <button class="btn-enroll-quick" onclick="enrollInCourse(${course.id})">
                                    تسجيل الآن
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                container.append(courseHtml);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}